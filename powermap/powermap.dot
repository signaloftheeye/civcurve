  n335 [label=<<B>SEC + CFTC nominees (Johnson, Levine, Anonick, Rowland)</B><BR/><FONT POINT-SIZE="13">Nominated Nov 12 2026: Kristin<BR/>N. Johnson + Steven Levine<BR/>(SEC), Nathan Anonick +<BR/>Matthew Rowland (CFTC); Senate<BR/>action pending</FONT>>];
