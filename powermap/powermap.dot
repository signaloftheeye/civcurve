  n350 [label=<<B>House Democrats (Meeks / Raskin / Kamlager-Dove)</B><BR/><FONT POINT-SIZE="13">House Foreign Affairs ranking<BR/>member Gregory Meeks,<BR/>Judiciary ranking member Jamie<BR/>Raskin, HFAC South/Central<BR/>Asia ranking member Sydney<BR/>Kamlager-Dove; Nov 17-18 2026<BR/>records demand to Cantor's<BR/>Brandon Lutnick; Meeks Nov 24<BR/>2026: asks Chairman Mast to<BR/>hold a public HFAC hearing<BR/>with Huang</FONT>>];
