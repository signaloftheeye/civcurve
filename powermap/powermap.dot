  n318 [label=<<B>Jeff Kessler (Commerce Under Secretary, BIS)</B><BR/><FONT POINT-SIZE="13">Under Secretary of Commerce<BR/>for Industry and Security<BR/>(BIS; reports to Lutnick);<BR/>named in Nvidia GC's Aug 2025<BR/>email to Megaspeed agents<BR/>(NYT); asked by House chairs<BR/>Nov 12 and Guthrie Nov 18 2026<BR/>for briefings; HFAC Nov 19<BR/>release: BIS approved &gt;879,000<BR/>AI chips for China (Dec<BR/>2025-May 2026 per Reuters);<BR/>BIS final rule adding<BR/>Megaspeed International and<BR/>six affiliates to the Entity<BR/>List filed Nov 23 2026 (signed<BR/>by DAS Julia Khersonsky)</FONT>>];
  n323 [label=<<B>House chairs (Mast / Moolenaar / Crawford)</B><BR/><FONT POINT-SIZE="13">House Foreign Affairs (Mast),<BR/>China Select (Moolenaar),<BR/>Intelligence (Crawford)<BR/>chairs; Nov 4 2026 letter to<BR/>Huang; Huang/Teter interviews<BR/>Dec 1-2; Mast published<BR/>Nvidia/AMD China AI-chip<BR/>license data Nov 19 2026 (ECRA<BR/>authority: 3.4 million<BR/>requested, &gt;879,000 approved<BR/>by BIS)</FONT>>];
