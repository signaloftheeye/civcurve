  n307 [label=<<B>Laura Loomer</B><BR/><FONT POINT-SIZE="13">Right-wing activist / Trump<BR/>ally; King Breaker Media; WaPo<BR/>Nov 7 2026: &gt;$60K in four<BR/>payments since May 2025,<BR/>Bruesewitz says for posts (she<BR/>says research doc)</FONT>>];
  n320 [label=<<B>Jensen Huang</B><BR/><FONT POINT-SIZE="13">Nvidia President, CEO and<BR/>director, reinstated Nov 22<BR/>2026 (8-K Item 5.02; unanimous<BR/>vote after 'input from senior<BR/>levels of the United States<BR/>government'); resigned Nov 11;<BR/>House HFAC/China Select/HPSCI<BR/>closed transcribed interview<BR/>Dec 1 (reaffirmed Nov 23) and<BR/>Senate Banking public hearing<BR/>Dec 3 (sole witness); Trump<BR/>SAID Nov 24 a pardon is<BR/>'always an option' (NY Post);<BR/>AG Blanche Nov 24 would not<BR/>say he was investigated;<BR/>independent-committee<BR/>(Wachtell) investigation<BR/>continues; VP Vance SAID Nov<BR/>25 he 'doesn't need a pardon<BR/>at all' and is 'under no<BR/>investigation' (no DOJ<BR/>document); five Senate<BR/>Democratic ranking members<BR/>demand an accounting of the<BR/>administration's role (Nov<BR/>24); Nov 26: Trump SAID Huang<BR/>is 'absolutely fine' and calls<BR/>his return a 'second term';<BR/>CBS (Nov 25, anon.): Rubio<BR/>memo and May Air Force One<BR/>briefing on Alice Huang intel,<BR/>Clayton intel review, Musk<BR/>contact</FONT>>];
