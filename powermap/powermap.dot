  n280 [label=<<B>Alice Huang (Megaspeed)</B><BR/><FONT POINT-SIZE="13">Chinese citizen; managing<BR/>director/senior executive of<BR/>Singapore Nvidia cloud partner<BR/>Megaspeed (Commerce chip-<BR/>diversion probe since 2024,<BR/>referred to DOJ); US officials<BR/>(anon., NYT Oct 2026) call her<BR/>a Chinese intelligence asset;<BR/>she has not commented;<BR/>Megaspeed and six affiliates<BR/>added to the BIS Entity List<BR/>Nov 23 2026; Bloomberg (Nov<BR/>27): GB300 NVL72 rack<BR/>(Gigabyte-built) in loan-<BR/>collateral filings at the<BR/>Yangtze River Delta Project,<BR/>Shanghai, a site linked to her</FONT>>];
  n285 [label=<<B>Bob Iger</B><BR/><FONT POINT-SIZE="13">Former Disney CEO; partner of<BR/>Josh Kushner in Thrive Eternal<BR/>(sports investing) and in the<BR/>pending $12.5B Lakers purchase</FONT>>];
