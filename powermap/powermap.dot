  n0 [label=<<B>Donald Trump</B><BR/><FONT POINT-SIZE="13">President (2nd term, 2025-);<BR/>Stephen Miller WH Chief of<BR/>Staff since Nov 9 2026;<BR/>Shenzhen Nov 19 2026:<BR/>bilateral with Putin and the<BR/>US-Russia-China trilateral;<BR/>Nov 20: SAID he fired<BR/>Cairncross, named Davies to<BR/>lead ONCD; Nov 23: SAID he<BR/>'made the deal' to reinstate<BR/>Huang, spoke to Nvidia's<BR/>board, and that AG Blanche<BR/>confirmed no evidence of<BR/>unlawful conduct (Truth Social<BR/>9:07 AM EST; CNBC, NYT<BR/>interviews); Nov 24: SAID<BR/>Huang pardon 'always an<BR/>option', Nvidia equity stake<BR/>'probably not too late' (NY<BR/>Post); nominated Jim O'Neill<BR/>(M.D.N.C.); NATO's Rutte due<BR/>at Mar-a-Lago Nov 25; Nov 25:<BR/>met NATO's Rutte at Mar-a-Lago<BR/>(closed press; joint<BR/>statement); USTR (Greer)<BR/>proposed Section 301 tariffs<BR/>on China + 13 economies;<BR/>Cornyn's blue-slip block on<BR/>Gaiser, WH vetting Fahey (Nov<BR/>23); Nov 26 Mar-a-Lago gaggle:<BR/>Huang 'absolutely fine', no<BR/>call since return; Senate<BR/>Judiciary got partial<BR/>Fahey/O'Neill paperwork Nov 25<BR/>(Reuters: replacing Gaiser)</FONT>>];
  n1 [label=<<B>JD Vance</B><BR/><FONT POINT-SIZE="13">Vice President (2025-); letter<BR/>to Iran SNSC secretary Rezaei<BR/>(Oct 2026); WSJ Nov 11 2026<BR/>(officials): Trump open to<BR/>Vance leading renewed Iran<BR/>talks; NYT (two people, Nov<BR/>23): at Trump's request spoke<BR/>privately with Huang and<BR/>helped Nvidia's board get<BR/>assurances (I; declined<BR/>comment); Oversight Dems' Nov<BR/>18 letter on Epstein meetings<BR/>/ Maxwell transfer, due Dec 2;<BR/>Nov 25 2026 (Wright-Patterson<BR/>AFB): SAID Huang 'doesn't need<BR/>a pardon at all' and that DOJ<BR/>and national-security<BR/>officials, including AG<BR/>Blanche, told him Huang is<BR/>'under no investigation'<BR/>(CBS/AP/NY Post)</FONT>>];
  n2 [label=<<B>Howard Lutnick</B><BR/><FONT POINT-SIZE="13">Commerce Secretary; ex-<BR/>BGC/Cantor chief; BIS Entity<BR/>List rule adding Megaspeed and<BR/>six affiliates filed Nov 23<BR/>2026 4:15 pm (after months of<BR/>intra-administration pressure,<BR/>Bessent Nov 13; earlier: no<BR/>Entity List additions in &gt;1<BR/>year); Reuters (documents, Nov<BR/>20): asked Pure Lithium for a<BR/>51% US stake in July, refused<BR/>(I); Commerce took a minority<BR/>equity stake in I-Pulse with a<BR/>$250M CHIPS award (Jun 25)</FONT>>];
