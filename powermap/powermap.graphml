<edge id="dmitriev-gerson-plan-2016" source="n99" target="n103"><data key="e_n">102</data><data key="e_id">dmitriev-gerson-plan-2016</data><data key="e_kind">register</data><data key="e_type">collaboration (US-Russia 'reconciliation' plan)</data><data key="e_category">business</data><data key="e_label">drafts 'reconciliation' plan 2016</data><data key="e_date">2016-11 - 2017-01</data><data key="e_grade">V</data><data key="e_saiddone"></data><data key="e_sequence_only">False</data><data key="e_status">active</data><data key="e_status_date"></data><data key="e_added_in">2026-10-09 (v4)</data><data key="e_last_checked">2026-10-09</data><data key="e_register_row_id">grokbot-2026-10-09-powermap-v4-V-dmitriev-gerson-plan-2016</data><data key="e_source_tier">press</data><data key="e_n_source_domains">2</data><data key="e_single_source">False</data><data key="e_sources">https://epic.org/wp-content/uploads/2022/02/Mueller-Report-vol-1.pdf ; https://www.nytimes.com/2019/04/20/us/politics/trump-putin-russia-mueller.html</data><data key="e_claim">TRANSITION BACK-CHANNEL: Mueller Report Vol. I: in Dec 2016-Jan 2017 Dmitriev and hedge-fund manager Rick Gerson drafted a short US-Russia reconciliation plan Dmitriev implied was cleared by Putin.</data></edge>
<edge id="gerson-kushner-plan-2017" source="n103" target="n36"><data key="e_n">103</data><data key="e_id">gerson-kushner-plan-2017</data><data key="e_kind">register</data><data key="e_type">friendship; passed document</data><data key="e_category">business</data><data key="e_label">friend; hands plan 2017</data><data key="e_date">2017-01 (pre-inauguration)</data><data key="e_grade">V</data><data key="e_saiddone"></data><data key="e_sequence_only">False</data><data key="e_status">active</data><data key="e_status_date"></data><data key="e_added_in">2026-10-09 (v4)</data><data key="e_last_checked">2026-10-09</data><data key="e_register_row_id">grokbot-2026-10-09-powermap-v4-V-gerson-kushner-plan-2017</data><data key="e_source_tier">press</data><data key="e_n_source_domains">2</data><data key="e_single_source">False</data><data key="e_sources">https://epic.org/wp-content/uploads/2022/02/Mueller-Report-vol-1.pdf ; https://www.washingtonpost.com/graphics/2019/politics/read-the-mueller-report/</data><data key="e_claim">CONTACT: Mueller Report: Gerson, 'a friend of Jared Kushner', gave the Dmitriev reconciliation plan to Kushner before the inauguration; Kushner gave copies to Bannon and Tillerson.</data></edge>
<edge id="dmitriev-prince-seychelles-2017" source="n99" target="n104"><data key="e_n">104</data><data key="e_id">dmitriev-prince-seychelles-2017</data><data key="e_kind">register</data><data key="e_type">documented meeting</data><data key="e_category">contact</data><data key="e_label">Seychelles mtgs 2017</data><data key="e_date">2017-01 (Seychelles, twice)</data><data key="e_grade">V</data><data key="e_saiddone"></data><data key="e_sequence_only">False</data><data key="e_status">active</data><data key="e_status_date"></data><data key="e_added_in">2026-10-09 (v4)</data><data key="e_last_checked">2026-10-09</data><data key="e_register_row_id">grokbot-2026-10-09-powermap-v4-V-dmitriev-prince-seychelles-2017</data><data key="e_source_tier">reference</data><data key="e_n_source_domains">1</data><data key="e_single_source">True</data><data key="e_sources">https://epic.org/wp-content/uploads/2022/02/Mueller-Report-vol-1.pdf</data><data key="e_claim">MEETING: Mueller Report: Dmitriev met Trump-campaign supporter Erik Prince twice in the Seychelles in Jan 2017 (arranged via George Nader) to discuss US-Russia relations.</data></edge>
<edge id="uae-nsa-introduced-dmitriev-gerson" source="n116" target="n99"><data key="e_n">105</data><data key="e_id">uae-nsa-introduced-dmitriev-gerson</data><data key="e_kind">register</data><data key="e_type">introduction (UAE NSA)</data><data key="e_category">business</data><data key="e_label">introduces to Gerson 2016 (I)</data><data key="e_date">2016-11</data><data key="e_grade">I</data><data key="e_saiddone"></data><data key="e_sequence_only">False</data><data key="e_status">active</data><data key="e_status_date"></data><data key="e_added_in">2026-10-09 (v4)</data><data key="e_last_checked">2026-10-09</data><data key="e_register_row_id">grokbot-2026-10-09-powermap-v4-I-uae-nsa-introduced-dmitriev-gerson</data><data key="e_source_tier">reference</data><data key="e_n_source_domains">2</data><data key="e_single_source">False</data><data key="e_sources">https://www.openmuellerreport.org/person/richard-gerson ; https://epic.org/wp-content/uploads/2022/02/Mueller-Report-vol-1.pdf</data><data key="e_claim">INTRODUCTION (I): Mueller Report says 'the UAE national security adviser introduced Dmitriev to Rick Gerson' in late Nov 2016. The report does not print the name; Tahnoon bin Zayed held that office then. Identity is inference from the office, hence I.</data></edge>
<edge id="putin-dmitriev-envoy-ofac" source="n91" target="n99"><data key="e_n">106</data><data key="e_id">putin-dmitriev-envoy-ofac</data><data key="e_kind">register</data><data key="e_type">appointment (special envoy) ; OFAC-designated</data><data key="e_category">appointment</data><data key="e_label">envoy; OFAC SDN 2022</data><data key="e_date">2022-02-28 (SDN) ; 2025 (envoy)</data><data key="e_grade">V</data><data key="e_saiddone"></data><data key="e_sequence_only">False</data><data key="e_status">active</data><data key="e_status_date"></data><data key="e_added_in">2026-10-09 (v4)</data><data key="e_last_checked">2026-10-09</data><data key="e_register_row_id">grokbot-2026-10-09-powermap-v4-V-putin-dmitriev-envoy-ofac</data><data key="e_source_tier">primary</data><data key="e_n_source_domains">2</data><data key="e_single_source">False</data><data key="e_sources">https://home.treasury.gov/news/press-releases/jy0612 ; https://tass.com/politics/2034787</data><data key="e_claim">APPOINTMENT: Dmitriev is Putin's special presidential envoy for investment and economic cooperation and RDIF CEO. OFAC designated RDIF and Dmitriev on Feb 28 2022 (EO 14024); his US entries need waivers.</data></edge>
<edge id="ushakov-witkoff-call-2025-10-14" source="n100" target="n6"><data key="e_n">107</data><data key="e_id">ushakov-witkoff-call-2025-10-14</data><data key="e_kind">register</data><data key="e_type">documented contact (call recording) + meetings</data><data key="e_category">contact</data><data key="e_label">Oct 14 2025 call (recorded)</data><data key="e_date">2025-02-18 ; 2025-10-14</data><data key="e_grade">V</data><data key="e_saiddone"></data><data key="e_sequence_only">False</data><data key="e_status">active</data><data key="e_status_date"></data><data key="e_added_in">2026-10-09 (v4)</data><data key="e_last_checked">2026-10-09</data><data key="e_register_row_id">grokbot-2026-10-09-powermap-v4-V-ushakov-witkoff-call-2025-10-14</data><data key="e_source_tier">primary</data><data key="e_n_source_domains">3</data><data key="e_single_source">False</data><data key="e_sources">https://apnews.com/article/trump-witkoff-putin-ukraine-bloomberg-3844a3721d92dd9ae9681547a0814d88 ; https://www.bloomberg.com/news/articles/2025-11-25/witkoff-discusses-ukraine-plans-with-key-putin-aide-transcript ; https://www.state.gov/secretary-rubios-meeting-with-russian-foreign-minister-lavrov</data><data key="e_claim">CONTACT: Bloomberg reviewed a recording of an Oct 14 2025 Witkoff-Ushakov call in which Witkoff coached Putin's top foreign-policy aide on pitching Trump (praise the Gaza deal, a '20-point' plan; 'Donetsk and maybe a land swap'). They also met at Riyadh Feb 18 2025. OUTCOME: Trump-Putin call followed on Oct 16 2025; the 28-point plan later emerged.</data></edge>
<edge id="putin-ushakov-aide" source="n91" target="n100"><data key="e_n">108</data><data key="e_id">putin-ushakov-aide</data><data key="e_kind">register</data><data key="e_type">employment (presidential aide)</data><data key="e_category">employment</data><data key="e_label">aide (foreign policy)</data><data key="e_date">2012 - present</data><data key="e_grade">V</data><data key="e_saiddone"></data><data key="e_sequence_only">False</data><data key="e_status">active</data><data key="e_status_date"></data><data key="e_added_in">2026-10-09 (v4)</data><data key="e_last_checked">2026-10-09</data><data key="e_register_row_id">grokbot-2026-10-09-powermap-v4-V-putin-ushakov-aide</data><data key="e_source_tier">primary</data><data key="e_n_source_domains">2</data><data key="e_single_source">False</data><data key="e_sources">https://www.state.gov/secretary-rubios-meeting-with-russian-foreign-minister-lavrov ; http://kremlin.ru/events/president/news/80961</data><data key="e_claim">EMPLOYMENT: Ushakov is Aide to the President of Russia (foreign policy); he joined Lavrov at Riyadh and reads out the Trump-Putin calls (State Dept readout; Kremlin).</data></edge>
<edge id="rubio-lavrov-riyadh-2025" source="n105" target="n101"><data key="e_n">109</data><data key="e_id">rubio-lavrov-riyadh-2025</data><data key="e_kind">register</data><data key="e_type">documented meeting</data><data key="e_category">contact</data><data key="e_label">Riyadh 2025-02-18</data><data key="e_date">2025-02-18</data><data key="e_grade">V</data><data key="e_saiddone"></data><data key="e_sequence_only">False</data><data key="e_status">active</data><data key="e_status_date"></data><data key="e_added_in">2026-10-09 (v4)</data><data key="e_last_checked">2026-10-09</data><data key="e_register_row_id">grokbot-2026-10-09-powermap-v4-V-rubio-lavrov-riyadh-2025</data><data key="e_source_tier">primary</data><data key="e_n_source_domains">2</data><data key="e_single_source">False</data><data key="e_sources">https://www.state.gov/secretary-rubios-meeting-with-russian-foreign-minister-lavrov ; https://mid.ru/en/foreign_policy/news/1998279/</data><data key="e_claim">MEETING: Rubio (with Waltz, Witkoff) met Lavrov (with Ushakov) at Diriyah Palace, Riyadh, Feb 18 2025, hosted by MBS. OUTCOME: agreed to restore missions, name high-level teams, explore economic cooperation incl. energy.</data></edge>
<edge id="putin-novak-deputy-pm" source="n91" target="n102"><data key="e_n">110</data><data key="e_id">putin-novak-deputy-pm</data><data key="e_kind">register</data><data key="e_type">appointment (Deputy PM, energy + economy)</data><data key="e_category">appointment</data><data key="e_label">Deputy PM 2024</data><data key="e_date">2024-05-14</data><data key="e_grade">V</data><data key="e_saiddone"></data><data key="e_sequence_only">False</data><data key="e_status">active</data><data key="e_status_date"></data><data key="e_added_in">2026-10-09 (v4)</data><data key="e_last_checked">2026-10-09</data><data key="e_register_row_id">grokbot-2026-10-09-powermap-v4-V-putin-novak-deputy-pm</data><data key="e_source_tier">primary</data><data key="e_n_source_domains">2</data><data key="e_single_source">False</data><data key="e_sources">http://en.kremlin.ru/events/president/news/74028 ; https://www.reuters.com/world/europe/russian-deputy-pm-given-new-tasks-coordination-economy-2024-05-17/</data><data key="e_claim">APPOINTMENT: Putin's decree of May 14 2024 reappointed Novak Deputy Prime Minister (energy; expanded to economic policy/sanctions mitigation). Novak announced the Oct-Dec 2026 diesel export schedule (register).</data></edge>
<edge id="bessent-treasury-ofac-smith" source="n3" target="n106"><data key="e_n">111</data><data key="e_id">bessent-treasury-ofac-smith</data><data key="e_kind">register</data><data key="e_type">employment (OFAC director under Treasury)</data><data key="e_category">employment</data><data key="e_label">OFAC director</data><data key="e_date">2023-09 - present</data><data key="e_grade">V</data><data key="e_saiddone"></data><data key="e_sequence_only">False</data><data key="e_status">active</data><data key="e_status_date"></data><data key="e_added_in">2026-10-09 (v4)</data><data key="e_last_checked">2026-10-09</data><data key="e_register_row_id">grokbot-2026-10-09-powermap-v4-V-bessent-treasury-ofac-smith</data><data key="e_source_tier">primary</data><data key="e_n_source_domains">2</data><data key="e_single_source">False</data><data key="e_sources">https://ofac.treasury.gov/media/934606/download?inline= ; https://www.reuters.com/markets/us/us-treasury-names-acting-senior-sanctions-official-2024-08-02/</data><data key="e_claim">EMPLOYMENT: Bradley T. Smith, career official (OFAC chief counsel 2013, deputy 2018, director Sep 2023; acting TFI under secretary Aug 2024), still signs OFAC general licenses as Director under Bessent's Treasury (e.g. ICCSR GL 10, Sep 4 2025).</data></edge>
<edge id="umerov-witkoff-kushner-miami" source="n107" target="n108"><data key="e_n">112</data><data key="e_id">umerov-witkoff-kushner-miami</data><data key="e_kind">register</data><data key="e_type">documented meetings (repeat)</data><data key="e_category">contact</data><data key="e_label">Miami talks 2025-26</data><data key="e_date">2025-12-05 ; 2026-10-09</data><data key="e_grade">V</data><data key="e_saiddone"></data><data key="e_sequence_only">False</data><data key="e_status">active</data><data key="e_status_date"></data><data key="e_added_in">2026-10-09 (v4)</data><data key="e_last_checked">2026-10-09</data><data key="e_register_row_id">grokbot-2026-10-09-powermap-v4-V-umerov-witkoff-kushner-miami</data><data key="e_source_tier">press</data><data key="e_n_source_domains">2</data><data key="e_single_source">False</data><data key="e_sources">https://www.reuters.com/world/europe/witkoff-ukraines-umerov-meeting-again-miami-friday-2025-12-05/ ; https://www.straitstimes.com/world/europe/witkoff-kushner-to-meet-ukrainians-in-miami-on-friday-says-us-source</data><data key="e_claim">MEETINGS: Ukraine's NSDC secretary Umerov met Witkoff in Miami (Dec 2025) and leads Kyiv's delegation (with Budanov, Arakhamia, Kyslytsya) meeting Witkoff and Kushner in Miami on Oct 9 2026.</data></edge>
<edge id="driscoll-vance-classmate-envoy" source="n1" target="n109"><data key="e_n">113</data><data key="e_id">driscoll-vance-classmate-envoy</data><data key="e_kind">register</data><data key="e_type">friendship (Yale Law classmates) -&gt; appointment</data><data key="e_category">appointment</data><data key="e_label">Yale Law friend -&gt; Ukraine envoy</data><data key="e_date">2025-02 - 2026-08-31</data><data key="e_grade">V</data><data key="e_saiddone"></data><data key="e_sequence_only">False</data><data key="e_status">active</data><data key="e_status_date"></data><data key="e_added_in">2026-10-09 (v4)</data><data key="e_last_checked">2026-10-09</data><data key="e_register_row_id">grokbot-2026-10-09-powermap-v4-V-driscoll-vance-classmate-envoy</data><data key="e_source_tier">press</data><data key="e_n_source_domains">2</data><data key="e_single_source">False</data><data key="e_sources">https://www.nbcnews.com/politics/national-security/drone-guy-ukraine-peace-negotiator-dan-driscoll-rcna246086 ; https://www.politico.com/news/2025/11/21/dan-driscoll-army-secretary-trump-administration-prominence-00663917</data><data key="e_claim">PERSONAL-&gt;APPOINTMENT: Army Secretary Dan Driscoll, Vance's Yale Law classmate and close friend, was sent by Trump to Kyiv, Geneva and Abu Dhabi (talks with Russians) in Nov 2025. Resigned Aug 31 2026 (register).</data></edge>
<edge id="araghchi-witkoff-oman-2025" source="n110" target="n6"><data key="e_n">114</data><data key="e_id">araghchi-witkoff-oman-2025</data><data key="e_kind">register</data><data key="e_type">documented meetings (repeat)</data><data key="e_category">contact</data><data key="e_label">Oman/Rome talks 2025</data><data key="e_date">2025-04-12 ; 2025-04-19 ; 2025-04-26</data><data key="e_grade">V</data><data key="e_saiddone"></data><data key="e_sequence_only">False</data><data key="e_status">active</data><data key="e_status_date"></data><data key="e_added_in">2026-10-09 (v4)</data><data key="e_last_checked">2026-10-09</data><data key="e_register_row_id">grokbot-2026-10-09-powermap-v4-V-araghchi-witkoff-oman-2025</data><data key="e_source_tier">press</data><data key="e_n_source_domains">1</data><data key="e_single_source">True</data><data key="e_sources">https://apnews.com/article/iran-us-nuclear-talks-oman-3aaca426accb6e450fef6395cc5de909</data><data key="e_claim">MEETINGS: Iranian FM Araghchi and Witkoff held Oman-mediated nuclear talks (Muscat Apr 12, brief face-to-face; Rome Apr 19; Muscat Apr 26 2025).</data></edge>
<edge id="ghalibaf-vance-islamabad-2026" source="n111" target="n1"><data key="e_n">115</data><data key="e_id">ghalibaf-vance-islamabad-2026</data><data key="e_kind">register</data><data key="e_type">documented meeting (Islamabad talks)</data><data key="e_category">contact</data><data key="e_label">Islamabad talks 2026-04</data><data key="e_date">2026-04</data><data key="e_grade">V</data><data key="e_saiddone"></data><data key="e_sequence_only">False</data><data key="e_status">active</data><data key="e_status_date"></data><data key="e_added_in">2026-10-09 (v4)</data><data key="e_last_checked">2026-10-09</data><data key="e_register_row_id">grokbot-2026-10-09-powermap-v4-V-ghalibaf-vance-islamabad-2026</data><data key="e_source_tier">primary</data><data key="e_n_source_domains">2</data><data key="e_single_source">False</data><data key="e_sources">https://abcnews.com/Politics/high-stakes-us-iran-peace-talks-led-vance/story?id=131924414 ; https://mofa.gov.pk/press-releases/arrival-of-the-us-delegation-for-islamabad-talks</data><data key="e_claim">MEETING: Vance led the US team (with Witkoff, Kushner) in ~21-hour Pakistan-mediated talks in Islamabad with Iran's Speaker Ghalibaf and FM Araghchi. OUTCOME: no agreement (Vance); later 'Islamabad MoU' status disputed (register).</data></edge>
<edge id="khamenei-mojtaba-son-ofac" source="n112" target="n113"><data key="e_n">116</data><data key="e_id">khamenei-mojtaba-son-ofac</data><data key="e_kind">register</data><data key="e_type">family (son) ; successor</data><data key="e_category">family</data><data key="e_label">son; successor 2026</data><data key="e_date">2019-11-04 (SDN) ; 2026-03-08 (elected)</data><data key="e_grade">V</data><data key="e_saiddone"></data><data key="e_sequence_only">False</data><data key="e_status">active</data><data key="e_status_date"></data><data key="e_added_in">2026-10-09 (v4)</data><data key="e_last_checked">2026-10-09</data><data key="e_register_row_id">grokbot-2026-10-09-powermap-v4-V-khamenei-mojtaba-son-ofac</data><data key="e_source_tier">primary</data><data key="e_n_source_domains">1</data><data key="e_single_source">True</data><data key="e_sources">https://home.treasury.gov/news/press-releases/sm824</data><data key="e_claim">FAMILY: Mojtaba is Ali Khamenei's second son; OFAC designated him Nov 4 2019 for acting for the Supreme Leader with IRGC-QF/Basij. Elected Supreme Leader by the Assembly of Experts Mar 8 2026 (Reuters, register).</data></edge>
<edge id="abdulmalik-houthi-leader" source="n115" target="n114"><data key="e_n">117</data><data key="e_id">abdulmalik-houthi-leader</data><data key="e_kind">register</data><data key="e_type">leadership ; UN/OFAC sanctions</data><data key="e_category">pardon/settlement</data><data key="e_label">leader (UN/OFAC 2015)</data><data key="e_date">2015-04-14</data><data key="e_grade">V</data><data key="e_saiddone"></data><data key="e_sequence_only">False</data><data key="e_status">active</data><data key="e_status_date"></data><data key="e_added_in">2026-10-09 (v4)</data><data key="e_last_checked">2026-10-09</data><data key="e_register_row_id">grokbot-2026-10-09-powermap-v4-V-abdulmalik-houthi-leader</data><data key="e_source_tier">primary</data><data key="e_n_source_domains">2</data><data key="e_single_source">False</data><data key="e_sources">https://main.un.org/securitycouncil/en/sanctions/2140/materials/summaries/individual/abdulmalik-al-houthi ; https://ofac.treasury.gov/recent-actions/20150414_33</data><data key="e_claim">LEADERSHIP: Abdul-Malik al-Houthi leads Ansar Allah; UN 2140 committee and OFAC (EO 13611) designated him Apr 14 2015; SDGT Jan 2021, revoked Feb 2021, Yemen listing remains.</data></edge>
<edge id="tahnoon-trump-wh-2025-03" source="n116" target="n0"><data key="e_n">118</data><data key="e_id">tahnoon-trump-wh-2025-03</data><data key="e_kind">register</data><data key="e_type">documented meeting (White House)</data><data key="e_category">contact</data><data key="e_label">WH mtg 2025-03-18</data><data key="e_date">2025-03-18</data><data key="e_grade">V</data><data key="e_saiddone"></data><data key="e_sequence_only">False</data><data key="e_status">active</data><data key="e_status_date"></data><data key="e_added_in">2026-10-09 (v4)</data><data key="e_last_checked">2026-10-09</data><data key="e_register_row_id">grokbot-2026-10-09-powermap-v4-V-tahnoon-trump-wh-2025-03</data><data key="e_source_tier">primary</data><data key="e_n_source_domains">2</data><data key="e_single_source">False</data><data key="e_sources">https://www.presidency.ucsb.edu/documents/statement-the-presidents-meeting-with-national-security-adviser-tahnoon-bin-zayed-al ; https://www.mediaoffice.abudhabi/en/government-affairs/tahnoon-bin-zayed-meets-donald-trump-discusses-strategic-partnership-prospects/</data><data key="e_claim">MEETING: Trump received UAE NSA Tahnoon bin Zayed (MGX chair) at the White House Mar 18 2025 (WH statement); dinner with senior officials. Ten months later WSJ reported his Aryam's 49% WLF stake (existing edge).</data></edge>
