<edge id="tamim-trump-sharm" source="n159" target="n0"><data key="e_n">168</data><data key="e_id">tamim-trump-sharm</data><data key="e_kind">register</data><data key="e_type">co-signatories (Gaza declaration)</data><data key="e_category">business</data><data key="e_label">co-sign Sharm 2025-10-13</data><data key="e_date">2025-10-13</data><data key="e_grade">V</data><data key="e_saiddone"></data><data key="e_sequence_only">False</data><data key="e_status">active</data><data key="e_status_date"></data><data key="e_added_in">2026-10-09 (v6)</data><data key="e_last_checked">2026-10-09</data><data key="e_register_row_id">grokbot-2026-10-09-powermap-v6-V-tamim-trump-sharm</data><data key="e_source_tier">primary</data><data key="e_n_source_domains">2</data><data key="e_single_source">False</data><data key="e_sources">https://www.diwan.gov.qa/en/Briefing-Room/News/International-Occasions/2025/October/13/HH-the-Amir-participates-in-signing-ceremony-of-agreement-to-end-the-war-in-Gaza ; https://www.thenationalnews.com/news/mena/2025/10/14/full-text-of-trump-peace-agreement-signed-by-leaders-of-us-egypt-qatar-and-turkey-in-sharm-el-sheikh/</data><data key="e_claim">SIGNING: Emir Tamim signed the Sharm el-Sheikh Gaza agreement with Trump, Sisi and Erdogan on Oct 13 2025 (Amiri Diwan).</data></edge>
<edge id="tamim-althani-pm" source="n159" target="n118"><data key="e_n">169</data><data key="e_id">tamim-althani-pm</data><data key="e_kind">register</data><data key="e_type">appointment (PM &amp; FM)</data><data key="e_category">appointment</data><data key="e_label">appoints PM</data><data key="e_date">2023-03</data><data key="e_grade">V</data><data key="e_saiddone"></data><data key="e_sequence_only">False</data><data key="e_status">active</data><data key="e_status_date"></data><data key="e_added_in">2026-10-09 (v6)</data><data key="e_last_checked">2026-10-09</data><data key="e_register_row_id">grokbot-2026-10-09-powermap-v6-V-tamim-althani-pm</data><data key="e_source_tier">primary</data><data key="e_n_source_domains">1</data><data key="e_single_source">True</data><data key="e_sources">https://www.diwan.gov.qa/en/Briefing-Room/News/International-Occasions/2025/October/13/HH-the-Amir-participates-in-signing-ceremony-of-agreement-to-end-the-war-in-Gaza</data><data key="e_claim">APPOINTMENT: The Emir appointed Sheikh Mohammed bin Abdulrahman PM (and FM); he attended Sharm with the Emir (Diwan).</data></edge>
<edge id="bessent-sanctions-lukoil-rosneft" source="n3" target="n92"><data key="e_n">170</data><data key="e_id">bessent-sanctions-lukoil-rosneft</data><data key="e_kind">register</data><data key="e_type">sanctions designation (Lukoil + Rosneft, EO 14024)</data><data key="e_category">pardon/settlement</data><data key="e_label">designates 2025-10-22</data><data key="e_date">2025-10-22</data><data key="e_grade">V</data><data key="e_saiddone"></data><data key="e_sequence_only">False</data><data key="e_status">active</data><data key="e_status_date"></data><data key="e_added_in">2026-10-09 (v7)</data><data key="e_last_checked">2026-10-09</data><data key="e_register_row_id">grokbot-2026-10-09-powermap-v7-V-bessent-sanctions-lukoil-rosneft</data><data key="e_source_tier">primary</data><data key="e_n_source_domains">2</data><data key="e_single_source">False</data><data key="e_sources">https://home.treasury.gov/news/press-releases/sb0290 ; https://ofac.treasury.gov/recent-actions/20251022</data><data key="e_claim">DESIGNATION: Treasury/OFAC designated Rosneft and Lukoil on Oct 22 2025 (first Ukraine-related sanctions of Trump's 2nd term). Bessent: 'Now is the time to stop the killing and for an immediate ceasefire.' GLs 126-128 covered wind-down and retail stations. This designation is why Lukoil must sell its foreign assets.</data></edge>
<edge id="treasury-blocks-gunvor-lukoil" source="n3" target="n160"><data key="e_n">171</data><data key="e_id">treasury-blocks-gunvor-lukoil</data><data key="e_kind">register</data><data key="e_type">license refusal (Lukoil bid)</data><data key="e_category">business</data><data key="e_label">'Kremlin's puppet' no license 2025-11</data><data key="e_date">2025-11-06</data><data key="e_grade">V</data><data key="e_saiddone"></data><data key="e_sequence_only">False</data><data key="e_status">active</data><data key="e_status_date"></data><data key="e_added_in">2026-10-09 (v7)</data><data key="e_last_checked">2026-10-09</data><data key="e_register_row_id">grokbot-2026-10-09-powermap-v7-V-treasury-blocks-gunvor-lukoil</data><data key="e_source_tier">press</data><data key="e_n_source_domains">2</data><data key="e_single_source">False</data><data key="e_sources">https://www.reuters.com/business/energy/gunvor-says-withdraws-bid-buy-assets-russian-energy-firm-lukoil-2025-11-06/ ; https://apnews.com/article/gunvor-lukoil-russia-ukraine-trump-kremlin-putin-4664b2a87135b8960dedf0ad463ee4f5</data><data key="e_claim">REFUSAL: Treasury's official X account: 'the Kremlin's puppet, Gunvor, will never get a license'. Gunvor withdrew its Lukoil international bid the same day (Reuters/AP).</data></edge>
<edge id="carlyle-lukoil-agreement" source="n161" target="n92"><data key="e_n">172</data><data key="e_id">carlyle-lukoil-agreement</data><data key="e_kind">register</data><data key="e_type">business deal (non-exclusive sale agreement, OFAC-contingent)</data><data key="e_category">business</data><data key="e_label">sale agreement 2026-01 (contingent)</data><data key="e_date">2026-01-29</data><data key="e_grade">V</data><data key="e_saiddone"></data><data key="e_sequence_only">False</data><data key="e_status">ended</data><data key="e_status_date">2026-07-31</data><data key="e_added_in">2026-10-09 (v7)</data><data key="e_last_checked">2026-10-21</data><data key="e_register_row_id">grokbot-2026-10-09-powermap-v7-V-carlyle-lukoil-agreement</data><data key="e_source_tier">primary</data><data key="e_n_source_domains">2</data><data key="e_single_source">False</data><data key="e_sources">https://www.lukoil.com/PressCenter/Pressreleases/Pressrelease/lukoil-agrees-with-carlyle-on-sale-of ; https://ofac.treasury.gov/media/936731/download</data><data key="e_claim">DEAL: Lukoil agreed Jan 29 2026 to sell Lukoil International GmbH (ex-Kazakhstan) to Carlyle, non-exclusive and contingent on OFAC authorization (Lukoil press release). OFAC GL 131 series (131I to Sep 19 2026; 131J to Oct 22 2026) authorizes only contingent contracts. Competing Boehly-led bid is pending.</data></edge>
<edge id="trump-barrack-syria-envoy" source="n0" target="n80"><data key="e_n">173</data><data key="e_id">trump-barrack-syria-envoy</data><data key="e_kind">register</data><data key="e_type">appointment (Special Envoy for Syria, + Amb. Turkey)</data><data key="e_category">appointment</data><data key="e_label">Syria envoy 2025-05</data><data key="e_date">2025-05-23</data><data key="e_grade">V</data><data key="e_saiddone"></data><data key="e_sequence_only">False</data><data key="e_status">active</data><data key="e_status_date"></data><data key="e_added_in">2026-10-09 (v7)</data><data key="e_last_checked">2026-10-23</data><data key="e_register_row_id">grokbot-2026-10-09-powermap-v7-V-trump-barrack-syria-envoy</data><data key="e_source_tier">primary</data><data key="e_n_source_domains">2</data><data key="e_single_source">False</data><data key="e_sources">https://www.reuters.com/world/middle-east/us-ambassador-turkey-will-serve-special-envoy-syria-2025-05-23/ ; https://www.state.gov/releases/office-of-the-spokesperson/2025/06/u-s-ambassador-to-turkiye-and-special-envoy-for-syria-thomas-barrack-and-acting-under-secretary-brad-smith-terrorism-and-financial-intelligence-treasury</data><data key="e_claim">APPOINTMENT: Barrack, Trump's longtime adviser and Ambassador to Turkey, took the Syria special envoy role May 23 2025 to carry out sanctions removal (Reuters; State Dept).</data></edge>
