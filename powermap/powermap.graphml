<edge id="oracle-tiktok-jv" source="n57" target="n60"><data key="e_n">48</data><data key="e_id">oracle-tiktok-jv</data><data key="e_kind">register</data><data key="e_type">business deal (equity + data custody)</data><data key="e_category">business</data><data key="e_label">15% TikTok JV 2026</data><data key="e_date">2026-01-22</data><data key="e_grade">V</data><data key="e_saiddone"></data><data key="e_sequence_only">False</data><data key="e_status">active</data><data key="e_status_date"></data><data key="e_added_in">2026-10-08 (v1)</data><data key="e_last_checked">2026-10-08</data><data key="e_register_row_id">grokbot-2026-10-08-V-powermap-oracle-tiktok-jv</data><data key="e_source_tier">primary</data><data key="e_n_source_domains">2</data><data key="e_single_source">False</data><data key="e_sources">https://www.reuters.com/world/china/tiktok-reaches-deal-new-us-joint-venture-avoid-american-ban-2026-01-23/ ; https://www.silverlake.com/tiktok-usds-joint-venture-llc-established-in-compliance-with-u-s-regulatory-requirements/</data><data key="e_claim">BUSINESS DEAL: TikTok USDS Joint Venture closed 2026-01-22 under the Trump-brokered divestiture; Oracle, Silver Lake and Abu Dhabi's MGX each hold 15% as managing investors, ByteDance 19.9%; Oracle hosts US data and validates the algorithm.</data></edge>
<edge id="ellison-father-son-skydance" source="n57" target="n56"><data key="e_n">49</data><data key="e_id">ellison-father-son-skydance</data><data key="e_kind">register</data><data key="e_type">family + funding</data><data key="e_category">family</data><data key="e_label">family + funding 2025-26</data><data key="e_date">2025 - 2026</data><data key="e_grade">V</data><data key="e_saiddone"></data><data key="e_sequence_only">False</data><data key="e_status">active</data><data key="e_status_date"></data><data key="e_added_in">2026-10-08 (v1)</data><data key="e_last_checked">2026-10-08</data><data key="e_register_row_id">grokbot-2026-10-08-V-powermap-ellison-father-son-skydance</data><data key="e_source_tier">primary</data><data key="e_n_source_domains">3</data><data key="e_single_source">False</data><data key="e_sources">https://en.wikipedia.org/wiki/David_Ellison ; https://www.prnewswire.com/news-releases/paramount-completes-acquisition-of-warner-bros-discovery-creating-a-new-global-entertainment-leader-skydance-302899765.html ; https://qz.com/ellison-family-17-billion-skydance-warner-bros-deal-100826</data><data key="e_claim">FAMILY/FUNDING: David Ellison (Skydance chair/CEO) is Larry Ellison's son; the Ellison family put ~$17B of equity into the WBD takeover and the family plus RedBird hold 100% of voting shares of the combined Skydance.</data></edge>
<edge id="paramount-16m-trump-fcc" source="n56" target="n0"><data key="e_n">50</data><data key="e_id">paramount-16m-trump-fcc</data><data key="e_kind">register</data><data key="e_type">settlement + regulatory approval (sequence)</data><data key="e_category">pardon/settlement</data><data key="e_label">$16M settlement -&gt; FCC OK 2025 (seq.)</data><data key="e_date">2025-07-02 ; 2025-07-24</data><data key="e_grade">V</data><data key="e_saiddone"></data><data key="e_sequence_only">True</data><data key="e_status">active</data><data key="e_status_date"></data><data key="e_added_in">2026-10-08 (v1)</data><data key="e_last_checked">2026-10-08</data><data key="e_register_row_id">grokbot-2026-10-08-V-powermap-paramount-16m-trump-fcc</data><data key="e_source_tier">primary</data><data key="e_n_source_domains">2</data><data key="e_single_source">False</data><data key="e_sources">https://www.reuters.com/business/media-telecom/paramount-settles-with-trump-over-60-minutes-interview-la-times-reports-2025-07-02/ ; https://www.fcc.gov/document/fcc-approves-skydance-paramount-cbs-transaction</data><data key="e_claim">SETTLEMENT/APPROVAL: Paramount paid $16M (to Trump's future library/fees, no apology) to settle his '60 Minutes' suit (July 2025); FCC approved the Skydance-Paramount merger 2025-07-24 after Skydance pledged an ombudsman and no DEI. FCC chair Carr says the two were unrelated.</data></edge>
