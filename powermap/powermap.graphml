<edge id="pierce-brokered-coinbase" source="n74" target="n75"><data key="e_n">309</data><data key="e_id">pierce-brokered-coinbase</data><data key="e_kind">register</data><data key="e_type">broker (Epstein stake)</data><data key="e_category">business</data><data key="e_label">brokered Epstein stake 2014</data><data key="e_date">2014</data><data key="e_grade">V</data><data key="e_saiddone"></data><data key="e_sequence_only">False</data><data key="e_status">active</data><data key="e_status_date"></data><data key="e_added_in">2026-10-09 (v2)</data><data key="e_last_checked">2026-10-09</data><data key="e_register_row_id">grokbot-2026-10-09-V-epstein-crypto-coinbase-blockstream-mit-dci</data><data key="e_source_tier">press</data><data key="e_n_source_domains">3</data><data key="e_single_source">False</data><data key="e_sources">https://www.theguardian.com/technology/2026/feb/09/jeffrey-epstein-crypto ; https://decrypt.co/356620/jeffrey-epstein-early-investor-coinbase-emails-reveal ; https://fortune.com/2026/02/06/jeffrey-epstein-files-coinbase-blockstream-michael-saylor-brock-pierce/</data><data key="e_claim">Brock Pierce (Tether co-founder) brokered Epstein's 2014 Coinbase investment; Coinbase co-founder Fred Ehrsam liaised with Pierce.</data></edge>
<edge id="epstein-pierce-sale-2018" source="n70" target="n74"><data key="e_n">310</data><data key="e_id">epstein-pierce-sale-2018</data><data key="e_kind">register</data><data key="e_type">business (half-stake sale, $15M)</data><data key="e_category">funding</data><data key="e_label">half-stake sale $15M 2018</data><data key="e_date">2018</data><data key="e_grade">I</data><data key="e_saiddone"></data><data key="e_sequence_only">False</data><data key="e_status">active</data><data key="e_status_date"></data><data key="e_added_in">2026-10-09 (v2)</data><data key="e_last_checked">2026-10-09</data><data key="e_register_row_id">grokbot-2026-10-09-V-epstein-crypto-coinbase-blockstream-mit-dci</data><data key="e_source_tier">press</data><data key="e_n_source_domains">3</data><data key="e_single_source">False</data><data key="e_sources">https://www.theguardian.com/technology/2026/feb/09/jeffrey-epstein-crypto ; https://decrypt.co/356620/jeffrey-epstein-early-investor-coinbase-emails-reveal ; https://fortune.com/2026/02/06/jeffrey-epstein-files-coinbase-blockstream-michael-saylor-brock-pierce/</data><data key="e_claim">Filings 'suggest' Epstein sold half his Coinbase shares to Pierce's Blockchain Capital for $15M in 2018 (I).</data></edge>
<edge id="epstein-summers-apr2016" source="n70" target="n72"><data key="e_n">311</data><data key="e_id">epstein-summers-apr2016</data><data key="e_kind">register</data><data key="e_type">contact (emails, 'digital currency')</data><data key="e_category">contact</data><data key="e_label">digital-currency emails 2016</data><data key="e_date">2016-04-02</data><data key="e_grade">V</data><data key="e_saiddone"></data><data key="e_sequence_only">False</data><data key="e_status">active</data><data key="e_status_date"></data><data key="e_added_in">2026-10-09 (v2)</data><data key="e_last_checked">2026-10-09</data><data key="e_register_row_id">grokbot-2026-10-09-V-summers-own-reply-apr2-2016-current-regime-not-digital-currency-spec</data><data key="e_source_tier">reference</data><data key="e_n_source_domains">2</data><data key="e_single_source">False</data><data key="e_sources">https://epsteinexposed.com/documents/efta-02346781 ; https://epsteinexposed.com/documents/efta-efta00830263 ; https://epsteinexposed.com/documents/efta-efta01773167 ; https://epsteinexposed.com/documents/efta-efta00830260 ; https://epsteinexposed.com/documents/efta-efta00830269 ; https://epsteinexposed.com/documents/efta-efta00830272 ; https://escapekey.substack.com/p/epstein-ii</data><data key="e_claim">Apr 2 2016 Epstein to Summers 'Digital currency... blockchain'; Summers: 'If I can't get current regime fixed I will fix' (no stated referent; currency reading = I). ~2h later Epstein to Thiel: 'larry summers is now on board' (Epstein SAID).</data></edge>
<edge id="epstein-routes-thiel-mbs-2017" source="n70" target="n51"><data key="e_n">312</data><data key="e_id">epstein-routes-thiel-mbs-2017</data><data key="e_kind">register</data><data key="e_type">named for Thiel to meet (email)</data><data key="e_category">contact</data><data key="e_label">named for Thiel to meet 2017</data><data key="e_date">2017-05-24</data><data key="e_grade">V</data><data key="e_saiddone"></data><data key="e_sequence_only">False</data><data key="e_status">active</data><data key="e_status_date"></data><data key="e_added_in">2026-10-09 (v2)</data><data key="e_last_checked">2026-10-09</data><data key="e_register_row_id">grokbot-2026-10-08-V-powermap-epstein-thiel-action-trail-2014-2017</data><data key="e_source_tier">press</data><data key="e_n_source_domains">7</data><data key="e_single_source">False</data><data key="e_sources">https://www.epsteinscan.org/document/424632 ; https://epstein-data.com/EFTA01045377 ; https://www.epsteinscan.org/document/697481 ; https://epsteinexposed.com/documents/efta-efta01914006 ; https://www.dropsitenews.com/p/modi-epstein-files-bannon-billionaire-anil-ambani-india-israel-united-states-justice-department ; https://www.thenationalnews.com/business/technology/saudi-arabia-s-crown-prince-wraps-up-whirlwind-tour-of-silicon-valley-1.719351 ; https://www.businessinsider.com/tim-cook-peter-thiel-rupert-murdoch-met-with-bin-salman-2020-1 ; https://www.bloomberg.com/news/articles/2018-04-06/google-thiel-stand-out-in-saudi-prince-s-silicon-valley-tour</data><data key="e_claim">2017-05-24 Thiel asked 'who should I meet in ME?'; Epstein routed him to MBS among others. SEQUENCE ONLY vs Thiel-MBS meeting Apr 2018; no source shows Epstein arranged it.</data></edge>
<edge id="epstein-routes-thiel-dubai-qatar-2017" source="n70" target="n52"><data key="e_n">313</data><data key="e_id">epstein-routes-thiel-dubai-qatar-2017</data><data key="e_kind">register</data><data key="e_type">named for Thiel to meet (email)</data><data key="e_category">contact</data><data key="e_label">named for Thiel to meet 2017</data><data key="e_date">2017-05-24</data><data key="e_grade">V</data><data key="e_saiddone"></data><data key="e_sequence_only">False</data><data key="e_status">active</data><data key="e_status_date"></data><data key="e_added_in">2026-10-09 (v2)</data><data key="e_last_checked">2026-10-09</data><data key="e_register_row_id">grokbot-2026-10-08-V-powermap-epstein-thiel-action-trail-2014-2017</data><data key="e_source_tier">primary</data><data key="e_n_source_domains">7</data><data key="e_single_source">False</data><data key="e_sources">https://www.epsteinscan.org/document/424632 ; https://epstein-data.com/EFTA01045377 ; https://www.epsteinscan.org/document/697481 ; https://epsteinexposed.com/documents/efta-efta01914006 ; https://www.dropsitenews.com/p/modi-epstein-files-bannon-billionaire-anil-ambani-india-israel-united-states-justice-department ; https://www.invest.qa/en/media-centre/news-and-articles/palantir-technologies-to-bring-big-data-expertise-to-support-qatars-economic-transformation ; https://investors.palantir.com/news-details/2025/Dubai-Holding-and-Palantir-launch-Aither-A-joint-venture-to-lead-AI-transformation/ ; https://thedefensepost.com/2026/03/25/lig-nex1-palantir-defense-uae/</data><data key="e_claim">Same 2017-05-24 exchange: Epstein routed Thiel to Sheikh Mohammed and Sultan bin Sulayem (Dubai) and Hamad bin Jassim (Qatar). SEQUENCE ONLY vs Palantir-Dubai Holding JV 2025; no source links them.</data></edge>
