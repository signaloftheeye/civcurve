<edge id="ambani-barrack-2017" source="n78" target="n80"><data key="e_n">316</data><data key="e_id">ambani-barrack-2017</data><data key="e_kind">register</data><data key="e_type">steered by Epstein</data><data key="e_category">contact</data><data key="e_label">steered by Epstein 2017</data><data key="e_date">2017</data><data key="e_grade">V</data><data key="e_saiddone"></data><data key="e_sequence_only">False</data><data key="e_status">active</data><data key="e_status_date"></data><data key="e_added_in">2026-10-09 (v2)</data><data key="e_last_checked">2026-10-09</data><data key="e_register_row_id">grokbot-2026-10-08-V-powermap-epstein-thiel-action-trail-2014-2017</data><data key="e_source_tier">press</data><data key="e_n_source_domains">4</data><data key="e_single_source">False</data><data key="e_sources">https://www.epsteinscan.org/document/424632 ; https://epstein-data.com/EFTA01045377 ; https://www.epsteinscan.org/document/697481 ; https://epsteinexposed.com/documents/efta-efta01914006 ; https://www.dropsitenews.com/p/modi-epstein-files-bannon-billionaire-anil-ambani-india-israel-united-states-justice-department ; The Hill Senate confirms Trump envoys to UK, Turkey, Italy; Reuters Barrack coverage Apr 29 2025</data><data key="e_claim">Epstein steered Anil Ambani to Tom Barrack (2017, Drop Site). Barrack confirmed US Ambassador to Turkey 2025-04-29.</data></edge>
<edge id="epstein-qatar-sharia-coin-2016" source="n70" target="n98"><data key="e_n">317</data><data key="e_id">epstein-qatar-sharia-coin-2016</data><data key="e_kind">register</data><data key="e_type">contact (pitch: 'sharia' digital currency)</data><data key="e_category">contact</data><data key="e_label">'sharia coin' pitch 2016-17</data><data key="e_date">2016-10-10 - 2017-01-26</data><data key="e_grade">V</data><data key="e_saiddone"></data><data key="e_sequence_only">False</data><data key="e_status">active</data><data key="e_status_date"></data><data key="e_added_in">2026-10-09 (v3)</data><data key="e_last_checked">2026-10-09</data><data key="e_register_row_id">grokbot-2026-10-09-V-epstein-sharia-digital-currency-qatar-2016-2017</data><data key="e_source_tier">reference</data><data key="e_n_source_domains">1</data><data key="e_single_source">True</data><data key="e_sources">https://tommycarstensen.com/epstein/data/documents/set11/02448/EFTA02448712.html ; https://tommycarstensen.com/epstein/data/documents/set9/01062/EFTA01062678.html ; https://tommycarstensen.com/epstein/data/documents/set11/02669/EFTA02669689.html ; https://tommycarstensen.com/epstein/data/documents/set11/02660/EFTA02660820.html</data><data key="e_claim">DOJ release: Epstein pitched a 'sharia compliant' blockchain currency to a Qatari contact ('Jabor Y.'; offered Doha meetings with Rayyan Bank's CEO and sharia head) Oct-Nov 2016 and to Fawzi Siam Jan 2017 ('we create the new currency... with sovereign involvement'). NOT shown: any currency built or sovereign uptake.</data></edge>
