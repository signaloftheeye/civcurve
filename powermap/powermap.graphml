<edge id="althani-witkoff-kushner-gaza" source="n118" target="n108"><data key="e_n">122</data><data key="e_id">althani-witkoff-kushner-gaza</data><data key="e_kind">register</data><data key="e_type">mediation (repeat meetings)</data><data key="e_category">contact</data><data key="e_label">Gaza mediation 2025-10</data><data key="e_date">2025-10</data><data key="e_grade">V</data><data key="e_saiddone"></data><data key="e_sequence_only">False</data><data key="e_status">active</data><data key="e_status_date"></data><data key="e_added_in">2026-10-09 (v4)</data><data key="e_last_checked">2026-10-09</data><data key="e_register_row_id">grokbot-2026-10-09-powermap-v4-V-althani-witkoff-kushner-gaza</data><data key="e_source_tier">press</data><data key="e_n_source_domains">2</data><data key="e_single_source">False</data><data key="e_sources">https://www.nbcnews.com/politics/donald-trump/israel-hamas-ceasefire-deal-came-together-rcna236789 ; https://www.cnn.com/2025/10/19/politics/how-qatar-became-trumps-key-ally-in-his-middle-east-peace-efforts</data><data key="e_claim">MEDIATION: Qatar's PM/FM Mohammed bin Abdulrahman Al Thani mediated the Oct 2025 Gaza ceasefire with Witkoff and Kushner. OUTCOME: Sharm el-Sheikh declaration Oct 13 2025, signed by Trump, Sisi, Emir Tamim, Erdogan.</data></edge>
<edge id="dermer-netanyahu" source="n119" target="n120"><data key="e_n">123</data><data key="e_id">dermer-netanyahu</data><data key="e_kind">register</data><data key="e_type">appointment (minister ; special envoy)</data><data key="e_category">appointment</data><data key="e_label">minister/envoy</data><data key="e_date">2022-12 - 2025-11-11</data><data key="e_grade">V</data><data key="e_saiddone"></data><data key="e_sequence_only">False</data><data key="e_status">active</data><data key="e_status_date"></data><data key="e_added_in">2026-10-09 (v4)</data><data key="e_last_checked">2026-10-09</data><data key="e_register_row_id">grokbot-2026-10-09-powermap-v4-V-dermer-netanyahu</data><data key="e_source_tier">press</data><data key="e_n_source_domains">2</data><data key="e_single_source">False</data><data key="e_sources">https://www.reuters.com/world/middle-east/israeli-minister-strategic-affairs-ron-dermer-has-resigned-israeli-media-reports-2025-11-11/ ; https://www.thenationalnews.com/news/mena/2025/11/12/ron-dermer-israeli-strategic-affairs-minister-and-netanyahu-confidant-resigns/</data><data key="e_claim">APPOINTMENT: Netanyahu confidant Ron Dermer was Strategic Affairs Minister until he resigned Nov 11 2025 after the Gaza deal. He stays a Netanyahu envoy on Abraham Accords expansion.</data></edge>
<edge id="blanche-maxwell-proffer-2025" source="n121" target="n122"><data key="e_n">124</data><data key="e_id">blanche-maxwell-proffer-2025</data><data key="e_kind">register</data><data key="e_type">documented meeting (DOJ proffer)</data><data key="e_category">contact</data><data key="e_label">DAG proffer 2025-07</data><data key="e_date">2025-07-24/25</data><data key="e_grade">V</data><data key="e_saiddone"></data><data key="e_sequence_only">False</data><data key="e_status">active</data><data key="e_status_date"></data><data key="e_added_in">2026-10-09 (v4)</data><data key="e_last_checked">2026-10-22</data><data key="e_register_row_id">grokbot-2026-10-09-powermap-v4-V-blanche-maxwell-proffer-2025</data><data key="e_source_tier">primary</data><data key="e_n_source_domains">2</data><data key="e_single_source">False</data><data key="e_sources">https://www.justice.gov/storage/audio-files/Interview%20Transcript/Interview%20Transcript%20-%20Maxwell%202025.07.24%20(Redacted).pdf ; https://www.whitehouse.senate.gov/wp-content/uploads/2025/08/2025-08-07-Letter-to-BOP-Maxwell-Transfer.pdf</data><data key="e_claim">MEETING: Then-Deputy AG Todd Blanche, formerly Trump's personal criminal lawyer, interviewed Maxwell at FCI Tallahassee Jul 24-25 2025 (DOJ released the transcript). OUTCOME: she was moved soon after to minimum-security FPC Bryan, TX. DOJ says no benefit was promised (Whitehouse letter disputes the transfer).</data></edge>
<edge id="epstein-beck-fec-2014" source="n70" target="n123"><data key="e_n">125</data><data key="e_id">epstein-beck-fec-2014</data><data key="e_kind">register</data><data key="e_type">funding (campaign, via PACs)</data><data key="e_category">funding</data><data key="e_label">$12.6K via PACs 2014</data><data key="e_date">2014</data><data key="e_grade">V</data><data key="e_saiddone"></data><data key="e_sequence_only">False</data><data key="e_status">active</data><data key="e_status_date"></data><data key="e_added_in">2026-10-09 (v4)</data><data key="e_last_checked">2026-10-09</data><data key="e_register_row_id">grokbot-2026-10-09-powermap-v4-V-epstein-beck-fec-2014</data><data key="e_source_tier">primary</data><data key="e_n_source_domains">2</data><data key="e_single_source">False</data><data key="e_sources">https://www.fec.gov/files/legal/adrs/780/15190301971.pdf ; https://www.arlnow.com/2015/01/08/why-did-the-infamous-jeffrey-epstein-give-generously-to-a-long-shot-local-congressional-campaign/</data><data key="e_claim">FUNDING: Epstein gave $12,600 to Gwendolyn Beck's 2014 independent VA-8 campaign and related PACs: $5,000 each to CIVIC and Eagles Party PAC, each followed by $2,600 to Beck's committee. FEC ADR found a de minimis limit violation (letter to Epstein lawyer Darren Indyke).</data></edge>
<edge id="epstein-npa-kellen-groff" source="n70" target="n124"><data key="e_n">126</data><data key="e_id">epstein-npa-kellen-groff</data><data key="e_kind">register</data><data key="e_type">employment ; named potential co-conspirators (NPA)</data><data key="e_category">employment</data><data key="e_label">NPA co-conspirators 2007</data><data key="e_date">2007-09-24</data><data key="e_grade">V</data><data key="e_saiddone"></data><data key="e_sequence_only">False</data><data key="e_status">active</data><data key="e_status_date"></data><data key="e_added_in">2026-10-09 (v4)</data><data key="e_last_checked">2026-10-09</data><data key="e_register_row_id">grokbot-2026-10-09-powermap-v4-V-epstein-npa-kellen-groff</data><data key="e_source_tier">primary</data><data key="e_n_source_domains">2</data><data key="e_single_source">False</data><data key="e_sources">https://www.justice.gov/opr/page/file/1336471/dl ; https://reason.com/wp-content/uploads/2021/08/Non-Prosecution-Agreement-1433.pdf</data><data key="e_claim">NPA: The 2007 federal non-prosecution agreement names Sarah Kellen, Lesley Groff, Adriana Ross and Nadia Marcinkova as potential co-conspirators the US will not charge (DOJ OPR report 2020).</data></edge>
<edge id="epstein-brunel-mc2" source="n70" target="n125"><data key="e_n">127</data><data key="e_id">epstein-brunel-mc2</data><data key="e_kind">register</data><data key="e_type">business (MC2 co-founder/financing)</data><data key="e_category">employment</data><data key="e_label">MC2 backer</data><data key="e_date">~2005 - 2015 ; d. 2022-02-19</data><data key="e_grade">V</data><data key="e_saiddone"></data><data key="e_sequence_only">False</data><data key="e_status">active</data><data key="e_status_date"></data><data key="e_added_in">2026-10-09 (v4)</data><data key="e_last_checked">2026-10-09</data><data key="e_register_row_id">grokbot-2026-10-09-powermap-v4-V-epstein-brunel-mc2</data><data key="e_source_tier">press</data><data key="e_n_source_domains">2</data><data key="e_single_source">False</data><data key="e_sources">https://www.reuters.com/world/europe/french-modelling-agent-who-founded-agency-with-epstein-dies-custody-2022-02-19/ ; https://www.bbc.com/news/world-europe-60443518</data><data key="e_claim">BUSINESS: French model agent Jean-Luc Brunel founded MC2 Model Management in the US with Epstein's backing ($1M credit line per reporting); found dead in La Sante prison Feb 19 2022 while charged with rape of minors.</data></edge>
<edge id="epstein-staley-fca" source="n126" target="n70"><data key="e_n">128</data><data key="e_id">epstein-staley-fca</data><data key="e_kind">register</data><data key="e_type">banker-client relationship ; regulatory finding</data><data key="e_category">business</data><data key="e_label">banker; FCA ban upheld 2025</data><data key="e_date">2000 - 2015 ; ban upheld 2025-06-26</data><data key="e_grade">V</data><data key="e_saiddone"></data><data key="e_sequence_only">False</data><data key="e_status">active</data><data key="e_status_date"></data><data key="e_added_in">2026-10-09 (v4)</data><data key="e_last_checked">2026-10-09</data><data key="e_register_row_id">grokbot-2026-10-09-powermap-v4-V-epstein-staley-fca</data><data key="e_source_tier">primary</data><data key="e_n_source_domains">2</data><data key="e_single_source">False</data><data key="e_sources">https://www.fca.org.uk/news/press-releases/upper-tribunal-upholds-jes-staley-ban ; https://www.reuters.com/sustainability/boards-policy-regulation/ex-barclays-ceo-staley-loses-appeal-against-uk-ban-over-epstein-ties-2025-06-26/</data><data key="e_claim">BANKER/FINDING: UK Upper Tribunal (Jun 26 2025) upheld the FCA ban on ex-JPMorgan/Barclays CEO Jes Staley: he recklessly approved misleading statements about his Epstein relationship; fine cut to GBP 1.1M.</data></edge>
<edge id="black-epstein-158m" source="n127" target="n70"><data key="e_n">129</data><data key="e_id">black-epstein-158m</data><data key="e_kind">register</data><data key="e_type">funding ($158M-$170M fees)</data><data key="e_category">funding</data><data key="e_label">$158-170M 2012-17</data><data key="e_date">2012 - 2017</data><data key="e_grade">V</data><data key="e_saiddone"></data><data key="e_sequence_only">False</data><data key="e_status">active</data><data key="e_status_date"></data><data key="e_added_in">2026-10-09 (v4)</data><data key="e_last_checked">2026-10-09</data><data key="e_register_row_id">grokbot-2026-10-09-powermap-v4-V-black-epstein-158m</data><data key="e_source_tier">primary</data><data key="e_n_source_domains">1</data><data key="e_single_source">True</data><data key="e_sources">https://www.finance.senate.gov/chairmans-news/wyden-unveils-ongoing-investigation-into-private-equity-billionaire-leon-blacks-tax-planning-and-financial-ties-with-jeffrey-epstein ; https://www.finance.senate.gov/ranking-members-news/wyden-releases-new-information-on-financing-of-jeffrey-epsteins-operations-by-billionaire-leon-black-seeks-documents-from-trump-administration</data><data key="e_claim">FUNDING: Apollo's Dechert review found Leon Black paid Epstein $158M (2012-17) for 'tax/estate advice'. Senate Finance (Wyden) puts it at ~$170M and says it funded Epstein's USVI operations.</data></edge>
<edge id="wexner-epstein-poa" source="n128" target="n70"><data key="e_n">130</data><data key="e_id">wexner-epstein-poa</data><data key="e_kind">register</data><data key="e_type">power of attorney (1991-2007)</data><data key="e_category">business</data><data key="e_label">power of attorney 1991-2007</data><data key="e_date">1991 - 2007-09</data><data key="e_grade">V</data><data key="e_saiddone"></data><data key="e_sequence_only">False</data><data key="e_status">active</data><data key="e_status_date"></data><data key="e_added_in">2026-10-09 (v4)</data><data key="e_last_checked">2026-10-09</data><data key="e_register_row_id">grokbot-2026-10-09-powermap-v4-V-wexner-epstein-poa</data><data key="e_source_tier">press</data><data key="e_n_source_domains">2</data><data key="e_single_source">False</data><data key="e_sources">https://www.pbs.org/newshour/politics/billionaire-les-wexner-is-being-deposed-in-the-epstein-files-probe-heres-what-documents-show-about-their-relationship ; https://www.nbcnews.com/politics/congress/billionaire-les-wexner-tells-lawmakers-was-conned-jeffrey-epstein-noth-rcna259573</data><data key="e_claim">POWER OF ATTORNEY: Wexner gave Epstein power of attorney in 1991 and says he revoked it in Sep 2007 (House Oversight deposition statement, Feb 18 2026).</data></edge>
<edge id="khanna-massie-efta" source="n129" target="n130"><data key="e_n">131</data><data key="e_id">khanna-massie-efta</data><data key="e_kind">register</data><data key="e_type">co-sponsors (Epstein Files Transparency Act)</data><data key="e_category">business</data><data key="e_label">EFTA co-sponsors 2025</data><data key="e_date">2025-07 - 2025-11-19</data><data key="e_grade">V</data><data key="e_saiddone"></data><data key="e_sequence_only">False</data><data key="e_status">active</data><data key="e_status_date"></data><data key="e_added_in">2026-10-09 (v4)</data><data key="e_last_checked">2026-10-09</data><data key="e_register_row_id">grokbot-2026-10-09-powermap-v4-V-khanna-massie-efta</data><data key="e_source_tier">primary</data><data key="e_n_source_domains">2</data><data key="e_single_source">False</data><data key="e_sources">https://www.congress.gov/bill/119th-congress/house-bill/4405/history ; https://www.whitehouse.gov/briefings-statements/2025/11/congressional-bill-h-r-4405-signed-into-law/</data><data key="e_claim">LEGISLATION: H.R.4405, introduced by Khanna and co-led by Massie (discharge petition), passed the House 427-1 and was signed Nov 19 2025 (P.L. 119-38). It binds DOJ (Bondi/Blanche) to release Epstein files.</data></edge>
<edge id="adelson-preserve-america-100m" source="n131" target="n0"><data key="e_n">132</data><data key="e_id">adelson-preserve-america-100m</data><data key="e_kind">register</data><data key="e_type">funding ($100M+ super PAC)</data><data key="e_category">funding</data><data key="e_label">$100M+ super PAC 2024</data><data key="e_date">2024-07 - 2024-10</data><data key="e_grade">V</data><data key="e_saiddone"></data><data key="e_sequence_only">False</data><data key="e_status">active</data><data key="e_status_date"></data><data key="e_added_in">2026-10-09 (v4)</data><data key="e_last_checked">2026-10-09</data><data key="e_register_row_id">grokbot-2026-10-09-powermap-v4-V-adelson-preserve-america-100m</data><data key="e_source_tier">primary</data><data key="e_n_source_domains">2</data><data key="e_single_source">False</data><data key="e_sources">https://docquery.fec.gov/cgi-bin/forms/C00878801/1827526/sa/11AI ; https://www.opensecrets.org/political-action-committees-pacs/preserve-america-pac/C00878801/donors/2024</data><data key="e_claim">FUNDING: FEC Schedule A: Miriam Adelson gave ~$100M (plus ~$6M in Oct) to pro-Trump Preserve America PAC in 2024.</data></edge>
<edge id="smith-signed-gl135" source="n106" target="n0"><data key="e_n">133</data><data key="e_id">smith-signed-gl135</data><data key="e_kind">register</data><data key="e_type">signature (OFAC GL 135) sequenced with Trump post</data><data key="e_category">business</data><data key="e_label">signs GL 135 2 min before post</data><data key="e_date">2026-10-09 14:43:59 ET</data><data key="e_grade">V</data><data key="e_saiddone"></data><data key="e_sequence_only">True</data><data key="e_status">active</data><data key="e_status_date"></data><data key="e_added_in">2026-10-09 (v5)</data><data key="e_last_checked">2026-10-09</data><data key="e_register_row_id">grokbot-2026-10-09-powermap-v5-V-smith-signed-gl135</data><data key="e_source_tier">primary</data><data key="e_n_source_domains">1</data><data key="e_single_source">True</data><data key="e_sources">https://ofac.treasury.gov/media/937216/download?inline= ; https://ofac.treasury.gov/recent-actions/20261009_33</data><data key="e_claim">SIGNATURE: OFAC Russia-related GL 135 (Russian-origin diesel sale/import, incl. into the US, to Apr 7 2027; no debits to CBR/NWF/MinFin accounts) is digitally signed by Director Bradley T. Smith at 14:43:59 -04:00 on Oct 9 2026. That is ~2 minutes before Trump's 2:46pm ET Truth Social diesel post. Who cleared it above Smith is not shown (hole stays open for clearance).</data></edge>
