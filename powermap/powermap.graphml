<edge id="lauder-trump-friend" source="n135" target="n0"><data key="e_n">143</data><data key="e_id">lauder-trump-friend</data><data key="e_kind">register</data><data key="e_type">friendship (Wharton) ; donor</data><data key="e_category">business</data><data key="e_label">Wharton friend; donor</data><data key="e_date">1960s - present</data><data key="e_grade">V</data><data key="e_saiddone"></data><data key="e_sequence_only">False</data><data key="e_status">active</data><data key="e_status_date"></data><data key="e_added_in">2026-10-09 (v5)</data><data key="e_last_checked">2026-10-09</data><data key="e_register_row_id">grokbot-2026-10-09-powermap-v5-V-lauder-trump-friend</data><data key="e_source_tier">press</data><data key="e_n_source_domains">2</data><data key="e_single_source">False</data><data key="e_sources">https://www.politico.com/story/2017/09/20/federal-reserve-chair-warsh-kevin-242901 ; https://fortune.com/2026/01/30/who-is-kevin-warsh-new-fed-chair-ronald-lauder-president-trump-greenland-college-friends/</data><data key="e_claim">PERSONAL: Ronald Lauder has known Trump since Wharton (Penn) and is a close friend, confidant and major GOP donor (Politico 2017; Fortune 2026).</data></edge>
<edge id="bondi-ballard-qatar-fara" source="n136" target="n137"><data key="e_n">144</data><data key="e_id">bondi-ballard-qatar-fara</data><data key="e_kind">register</data><data key="e_type">foreign agent (FARA) ; employment</data><data key="e_category">employment</data><data key="e_label">FARA agent 2019-20</data><data key="e_date">2019-07 - 2020</data><data key="e_grade">V</data><data key="e_saiddone"></data><data key="e_sequence_only">False</data><data key="e_status">active</data><data key="e_status_date"></data><data key="e_added_in">2026-10-09 (v5)</data><data key="e_last_checked">2026-10-09</data><data key="e_register_row_id">grokbot-2026-10-09-powermap-v5-V-bondi-ballard-qatar-fara</data><data key="e_source_tier">primary</data><data key="e_n_source_domains">1</data><data key="e_single_source">True</data><data key="e_sources">https://efile.fara.gov/docs/6415-Short-Form-20190723-106.pdf ; https://efile.fara.gov/docs/6415-Exhibit-AB-20190723-16.pdf</data><data key="e_claim">FARA: Ballard Partners (reg. 6415) added Pamela Bondi in Jul 2019 as Key Personnel on its Qatar Embassy contract (anti-trafficking; political activity checked). Fee to the firm was $115K/month Jul 2019-Jun 2020, then $50K/month to Dec 2020. Bondi says the fee went to the firm, not her.</data></edge>
<edge id="doj-fbi-epstein-memo-2025" source="n136" target="n138"><data key="e_n">145</data><data key="e_id">doj-fbi-epstein-memo-2025</data><data key="e_kind">register</data><data key="e_type">joint DOJ-FBI memo (Epstein) ; internal clash</data><data key="e_category">business</data><data key="e_label">Epstein memo 2025-07-07</data><data key="e_date">2025-07-07</data><data key="e_grade">V</data><data key="e_saiddone"></data><data key="e_sequence_only">False</data><data key="e_status">active</data><data key="e_status_date"></data><data key="e_added_in">2026-10-09 (v5)</data><data key="e_last_checked">2026-10-09</data><data key="e_register_row_id">grokbot-2026-10-09-powermap-v5-V-doj-fbi-epstein-memo-2025</data><data key="e_source_tier">press</data><data key="e_n_source_domains">2</data><data key="e_single_source">False</data><data key="e_sources">https://www.documentcloud.org/documents/25993306-doj-epstein-july-2025-memo/ ; https://apnews.com/article/epstein-files-dan-bongino-bondi-trump-fbi-0f02f67b6c97fc50e4d93bc4dbf4c4d0</data><data key="e_claim">MEMO: The unsigned DOJ-FBI memo of Jul 7 2025 found no 'client list', no credible blackmail evidence and no basis to charge third parties, and ruled out further disclosure. It contradicted Bondi's earlier 'on my desk' remark. Patel and Bongino backed it, then Bongino clashed with Bondi (AP). OUTCOME: the backlash fed the EFTA (signed Nov 19 2025).</data></edge>
<edge id="bondi-halligan-appointment" source="n136" target="n139"><data key="e_n">146</data><data key="e_id">bondi-halligan-appointment</data><data key="e_kind">register</data><data key="e_type">appointment (interim US Attorney EDVA) -&gt; ruled invalid</data><data key="e_category">appointment</data><data key="e_label">installs; ruled invalid 2025-11</data><data key="e_date">2025-09 ; 2025-11-24</data><data key="e_grade">V</data><data key="e_saiddone"></data><data key="e_sequence_only">False</data><data key="e_status">active</data><data key="e_status_date"></data><data key="e_added_in">2026-10-09 (v5)</data><data key="e_last_checked">2026-10-09</data><data key="e_register_row_id">grokbot-2026-10-09-powermap-v5-V-bondi-halligan-appointment</data><data key="e_source_tier">primary</data><data key="e_n_source_domains">2</data><data key="e_single_source">False</data><data key="e_sources">https://levin-center.org/wp-content/uploads/2026/01/2025-11-24-Opinion-and-Order-Granting-Motion-to-Dismiss-Indictment.pdf ; https://www.congress.gov/crs_external_products/LSB/PDF/LSB11380/LSB11380.1.pdf</data><data key="e_claim">APPOINTMENT: Bondi installed ex-WH aide Lindsey Halligan as interim US Attorney (EDVA) days before Halligan alone obtained the Comey indictment (Sep 25 2025) and the Letitia James indictment. On Nov 24 2025 Judge Currie ruled the appointment invalid (28 USC 546) and dismissed both without prejudice; DOJ appealed.</data></edge>
<edge id="khalid-bin-salman-hegseth" source="n140" target="n14"><data key="e_n">147</data><data key="e_id">khalid-bin-salman-hegseth</data><data key="e_kind">register</data><data key="e_type">documented meeting (Pentagon)</data><data key="e_category">contact</data><data key="e_label">Pentagon 2025-02-24</data><data key="e_date">2025-02-24</data><data key="e_grade">V</data><data key="e_saiddone"></data><data key="e_sequence_only">False</data><data key="e_status">active</data><data key="e_status_date"></data><data key="e_added_in">2026-10-09 (v5)</data><data key="e_last_checked">2026-10-09</data><data key="e_register_row_id">grokbot-2026-10-09-powermap-v5-V-khalid-bin-salman-hegseth</data><data key="e_source_tier">primary</data><data key="e_n_source_domains">2</data><data key="e_single_source">False</data><data key="e_sources">https://www.defense.gov/News/Transcripts/Transcript/Article/4077391/secretary-of-defense-pete-hegseth-greets-saudi-minister-of-defense-his-royal-hi/ ; https://www.reuters.com/world/saudi-defence-minister-us-defense-secretary-discuss-cooperation-washington-2025-02-25/</data><data key="e_claim">MEETING: Saudi Defense Minister Khalid bin Salman (MBS's brother) met Hegseth at the Pentagon Feb 24 2025 (Iran and the Houthis on the agenda; DoD transcript).</data></edge>
