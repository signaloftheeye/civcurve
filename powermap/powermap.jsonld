{
 "@context": {
  "@version": 1.1,
  "@base": "https://signaloftheeye.github.io/civcurve/powermap/",
  "schema": "https://schema.org/",
  "pm": "https://signaloftheeye.github.io/civcurve/powermap/vocab#",
  "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
  "xsd": "http://www.w3.org/2001/XMLSchema#",
  "name": "schema:name",
  "description": "schema:description",
  "citation": {
   "@id": "schema:citation",
   "@type": "@id",
   "@container": "@set"
  },
  "from": {
   "@id": "pm:from",
   "@type": "@id"
  },
  "to": {
   "@id": "pm:to",
   "@type": "@id"
  },
  "sequenceOnly": {
   "@id": "pm:sequenceOnly",
   "@type": "xsd:boolean"
  },
  "newInVersion": {
   "@id": "pm:newInVersion",
   "@type": "xsd:boolean"
  },
  "tieType": "pm:tieType",
  "category": "pm:category",
  "cluster": "pm:cluster",
  "clusterLabel": "pm:clusterLabel",
  "date": "pm:date",
  "grade": "pm:grade",
  "saidDone": "pm:saidDone",
  "status": "pm:status",
  "statusDate": "pm:statusDate",
  "statusNote": "pm:statusNote",
  "addedIn": "pm:addedIn",
  "lastChecked": "pm:lastChecked",
  "registerRow": "pm:registerRow",
  "kind": "pm:kind",
  "sourceTier": "pm:sourceTier",
  "singleSource": "pm:singleSource",
  "nSourceDomains": "pm:nSourceDomains"
 },
 "@graph": [
  {
   "@id": "#dataset",
   "@type": "schema:Dataset",
   "name": "US POWER MAP v19 - documented ties as of 2026-10-23",
   "description": "302 filed power-map links + 15 Epstein-network edges from register rows = 317 sourced edges; 22 context ties; 263 nodes. 6 edges new in v19. Receipts only: no tie implies intent or causation.",
   "schema:version": "v19",
   "schema:dateModified": "2026-10-23",
   "schema:isBasedOn": "register/claims.jsonl (open register; every sourced tie is one row)",
   "schema:distribution": [
    {
     "@type": "schema:DataDownload",
     "schema:contentUrl": "https://signaloftheeye.github.io/civcurve/powermap/powermap.json",
     "schema:encodingFormat": "application/json"
    },
    {
     "@type": "schema:DataDownload",
     "schema:contentUrl": "https://signaloftheeye.github.io/civcurve/powermap/powermap.jsonld",
     "schema:encodingFormat": "application/ld+json"
    },
    {
     "@type": "schema:DataDownload",
     "schema:contentUrl": "https://signaloftheeye.github.io/civcurve/powermap/powermap.ttl",
     "schema:encodingFormat": "text/turtle"
    },
    {
     "@type": "schema:DataDownload",
     "schema:contentUrl": "https://signaloftheeye.github.io/civcurve/powermap/powermap.graphml",
     "schema:encodingFormat": "application/graphml+xml"
    },
    {
     "@type": "schema:DataDownload",
     "schema:contentUrl": "https://signaloftheeye.github.io/civcurve/powermap/powermap-edges.csv",
     "schema:encodingFormat": "text/csv"
    },
    {
     "@type": "schema:DataDownload",
     "schema:contentUrl": "https://signaloftheeye.github.io/civcurve/powermap/powermap-nodes.csv",
     "schema:encodingFormat": "text/csv"
    }
   ]
  },
  {
   "@id": "pm:Actor",
   "@type": "rdfs:Class",
   "rdfs:comment": "A person, family, company, office, fund or state on the map."
  },
  {
   "@id": "pm:Tie",
   "@type": "rdfs:Class",
   "rdfs:comment": "One documented tie between two actors, backed by a register row and source URLs."
  },
  {
   "@id": "pm:from",
   "@type": "rdf:Property",
   "rdfs:comment": "Actor the tie was filed from (direction as filed; read description for who did what)."
  },
  {
   "@id": "pm:to",
   "@type": "rdf:Property",
   "rdfs:comment": "Actor the tie was filed to."
  },
  {
   "@id": "pm:tieType",
   "@type": "rdf:Property",
   "rdfs:comment": "Kind of tie in words (family, marriage, funding, employment, appointment, board, contract, deal, pardon...)."
  },
  {
   "@id": "pm:category",
   "@type": "rdf:Property",
   "rdfs:comment": "Colour category used in the drawn map."
  },
  {
   "@id": "pm:cluster",
   "@type": "rdf:Property",
   "rdfs:comment": "Power-centre cluster key."
  },
  {
   "@id": "pm:clusterLabel",
   "@type": "rdf:Property",
   "rdfs:comment": "Human label of the cluster."
  },
  {
   "@id": "pm:date",
   "@type": "rdf:Property",
   "rdfs:comment": "Date or date range of the tie, as text."
  },
  {
   "@id": "pm:grade",
   "@type": "rdf:Property",
   "rdfs:comment": "V = verified on primary/reputable sources; I = partly supported. Null for context ties."
  },
  {
   "@id": "pm:saidDone",
   "@type": "rdf:Property",
   "rdfs:comment": "SAID = statement/claim; DONE = act on record; BOTH."
  },
  {
   "@id": "pm:sequenceOnly",
   "@type": "rdf:Property",
   "rdfs:comment": "true = A then B in time only; no cause is claimed."
  },
  {
   "@id": "pm:status",
   "@type": "rdf:Property",
   "rdfs:comment": "active | ended | pending | enjoined | changed | retired (as of statusDate)."
  },
  {
   "@id": "pm:statusDate",
   "@type": "rdf:Property",
   "rdfs:comment": "Date the status was last set."
  },
  {
   "@id": "pm:statusNote",
   "@type": "rdf:Property",
   "rdfs:comment": "Why the status is what it is."
  },
  {
   "@id": "pm:addedIn",
   "@type": "rdf:Property",
   "rdfs:comment": "Map version (and date) the tie first appeared."
  },
  {
   "@id": "pm:lastChecked",
   "@type": "rdf:Property",
   "rdfs:comment": "Date the tie was last re-checked."
  },
  {
   "@id": "pm:registerRow",
   "@type": "rdf:Property",
   "rdfs:comment": "Id of the open-register row (register/claims.jsonl) that carries the tie."
  },
  {
   "@id": "pm:kind",
   "@type": "rdf:Property",
   "rdfs:comment": "register = sourced tie with its own row; context = named inside rows, no row of its own."
  },
  {
   "@id": "pm:newInVersion",
   "@type": "rdf:Property",
   "rdfs:comment": "true if the tie is new in this map version."
  },
  {
   "@id": "pm:sourceTier",
   "@type": "rdf:Property",
   "rdfs:comment": "v17: best tier among the tie's source URLs: primary | press | reference | social | other (where the paper sits, not a grade)."
  },
  {
   "@id": "pm:singleSource",
   "@type": "rdf:Property",
   "rdfs:comment": "v17: true when all source URLs share one domain (re-check first)."
  },
  {
   "@id": "pm:nSourceDomains",
   "@type": "rdf:Property",
   "rdfs:comment": "v17: number of distinct source domains."
  },
