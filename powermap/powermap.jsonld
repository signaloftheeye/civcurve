{"@context": {"@version": 1.1, "@base": "https://signaloftheeye.github.io/civcurve/powermap/", "schema": "https://schema.org/", "pm": "https://signaloftheeye.github.io/civcurve/powermap/vocab#", "rdfs": "http://www.w3.org/2000/01/rdf-schema#", "xsd": "http://www.w3.org/2001/XMLSchema#", "name": "schema:name", "description": "schema:description", "citation": {"@id": "schema:citation", "@type": "@id", "@container": "@set"}, "from": {"@id": "pm:from", "@type": "@id"}, "to": {"@id": "pm:to", "@type": "@id"}, "sequenceOnly": {"@id": "pm:sequenceOnly", "@type": "xsd:boolean"}, "newInVersion": {"@id": "pm:newInVersion", "@type": "xsd:boolean"}, "tieType": "pm:tieType", "category": "pm:category", "cluster": "pm:cluster", "clusterLabel": "pm:clusterLabel", "date": "pm:date", "grade": "pm:grade", "saidDone": "pm:saidDone", "status": "pm:status", "statusDate": "pm:statusDate", "statusNote": "pm:statusNote", "addedIn": "pm:addedIn", "lastChecked": "pm:lastChecked", "registerRow": "pm:registerRow", "kind": "pm:kind", "sourceTier": "pm:sourceTier", "singleSource": "pm:singleSource", "nSourceDomains": "pm:nSourceDomains", "entityKind": "pm:entityKind"}, "@graph": [{"@id": "#dataset", "@type": "schema:Dataset", "name": "US POWER MAP v44 - documented ties as of 2026-11-27", "description": "494 filed power-map links + 15 Epstein-network edges from register rows = 509 sourced edges; 22 context ties; 385 nodes. 8 edges new in v44. Receipts only: no tie implies intent or causation.", "schema:version": "v44", "schema:dateModified": "2026-11-27", "schema:isBasedOn": "register/claims.jsonl (open register; every sourced tie is one row)", "schema:distribution": [{"@type": "schema:DataDownload", "schema:contentUrl": "https://signaloftheeye.github.io/civcurve/powermap/powermap.json", "schema:encodingFormat": "application/json"}, {"@type": "schema:DataDownload", "schema:contentUrl": "https://signaloftheeye.github.io/civcurve/powermap/powermap.jsonld", "schema:encodingFormat": "application/ld+json"}, {"@type": "schema:DataDownload", "schema:contentUrl": "https://signaloftheeye.github.io/civcurve/powermap/powermap.ttl", "schema:encodingFormat": "text/turtle"}, {"@type": "schema:DataDownload", "schema:contentUrl": "https://signaloftheeye.github.io/civcurve/powermap/powermap.graphml", "schema:encodingFormat": "application/graphml+xml"}, {"@type": "schema:DataDownload", "schema:contentUrl": "https://signaloftheeye.github.io/civcurve/powermap/powermap-edges.csv", "schema:encodingFormat": "text/csv"}, {"@type": "schema:DataDownload", "schema:contentUrl": "https://signaloftheeye.github.io/civcurve/powermap/powermap-nodes.csv", "schema:encodingFormat": "text/csv"}]}, {"@id": "pm:Actor", "@type": "rdfs:Class", "rdfs:comment": "A person, family, company, office, fund or state on the map."}, {"@id": "pm:Tie", "@type": "rdfs:Class", "rdfs:comment": "One documented tie between two actors, backed by a register row and source URLs."}, {"@id": "pm:from", "@type": "rdf:Property", "rdfs:comment": "Actor the tie was filed from (direction as filed; read description for who did what)."}, {"@id": "pm:to", "@type": "rdf:Property", "rdfs:comment": "Actor the tie was filed to."}, {"@id": "pm:tieType", "@type": "rdf:Property", "rdfs:comment": "Kind of tie in words (family, marriage, funding, employment, appointment, board, contract, deal, pardon...)."}, {"@id": "pm:category", "@type": "rdf:Property", "rdfs:comment": "Colour category used in the drawn map."}, {"@id": "pm:cluster", "@type": "rdf:Property", "rdfs:comment": "Power-centre cluster key."}, {"@id": "pm:clusterLabel", "@type": "rdf:Property", "rdfs:comment": "Human label of the cluster."}, {"@id": "pm:date", "@type": "rdf:Property", "rdfs:comment": "Date or date range of the tie, as text."}, {"@id": "pm:grade", "@type": "rdf:Property", "rdfs:comment": "V = verified on primary/reputable sources; I = partly supported. Null for context ties."}, {"@id": "pm:saidDone", "@type": "rdf:Property", "rdfs:comment": "SAID = statement/claim; DONE = act on record; BOTH."}, {"@id": "pm:sequenceOnly", "@type": "rdf:Property", "rdfs:comment": "true = A then B in time only; no cause is claimed."}, {"@id": "pm:status", "@type": "rdf:Property", "rdfs:comment": "active | ended | pending | enjoined | changed | retired (as of statusDate)."}, {"@id": "pm:statusDate", "@type": "rdf:Property", "rdfs:comment": "Date the status was last set."}, {"@id": "pm:statusNote", "@type": "rdf:Property", "rdfs:comment": "Why the status is what it is."}, {"@id": "pm:addedIn", "@type": "rdf:Property", "rdfs:comment": "Map version (and date) the tie first appeared."}, {"@id": "pm:lastChecked", "@type": "rdf:Property", "rdfs:comment": "Date the tie was last re-checked."}, {"@id": "pm:registerRow", "@type": "rdf:Property", "rdfs:comment": "Id of the open-register row (register/claims.jsonl) that carries the tie."}, {"@id": "pm:kind", "@type": "rdf:Property", "rdfs:comment": "register = sourced tie with its own row; context = named inside rows, no row of its own."}, {"@id": "pm:newInVersion", "@type": "rdf:Property", "rdfs:comment": "true if the tie is new in this map version."}, {"@id": "pm:sourceTier", "@type": "rdf:Property", "rdfs:comment": "v17: best tier among the tie's source URLs: primary | press | reference | social | other (where the paper sits, not a grade)."}, {"@id": "pm:singleSource", "@type": "rdf:Property", "rdfs:comment": "v17: true when all source URLs share one domain (re-check first)."}, {"@id": "pm:nSourceDomains", "@type": "rdf:Property", "rdfs:comment": "v17: number of distinct source domains."}, {"@id": "pm:Group", "@type": "rdfs:Class", "rdfs:comment": "v31: one node naming several people or bodies together (e.g. joint envoys); not a legal entity."}, {"@id": "pm:entityKind", "@type": "rdf:Property", "rdfs:comment": "v31: person | organization | government | group (also given as a second rdf:type: schema:Person / schema:Organization / schema:GovernmentOrganization / pm:Group)."}, {"@id": "node/donald-trump", "@type": ["pm:Actor", "schema:Person"], "name": "Donald Trump", "description": "President (2nd term, 2025-); Stephen Miller WH Chief of Staff since Nov 9 2026; Shenzhen Nov 19 2026: bilateral with Putin and the US-Russia-China trilateral; Nov 20: SAID he fired Cairncross, named Davies to lead ONCD; Nov 23: SAID he 'made the deal' to reinstate Huang, spoke to Nvidia's board, and that AG Blanche confirmed no evidence of unlawful conduct (Truth Social 9:07 AM EST; CNBC, NYT interviews); Nov 24: SAID Huang pardon 'always an option', Nvidia equity stake 'probably not too late' (NY Post); nominated Jim O'Neill (M.D.N.C.); NATO's Rutte due at Mar-a-Lago Nov 25; Nov 25: met NATO's Rutte at Mar-a-Lago (closed press; joint statement); USTR (Greer) proposed Section 301 tariffs on China + 13 economies; Cornyn's blue-slip block on Gaiser, WH vetting Fahey (Nov 23); Nov 26 Mar-a-Lago gaggle: Huang 'absolutely fine', no call since return; Senate Judiciary got partial Fahey/O'Neill paperwork Nov 25 (Reuters: replacing Gaiser)", "cluster": "gov", "clusterLabel": "Government / White House", "entityKind": "person"}, {"@id": "node/jd-vance", "@type": ["pm:Actor", "schema:Person"], "name": "JD Vance", "description": "Vice President (2025-); letter to Iran SNSC secretary Rezaei (Oct 2026); WSJ Nov 11 2026 (officials): Trump open to Vance leading renewed Iran talks; NYT (two people, Nov 23): at Trump's request spoke privately with Huang and helped Nvidia's board get assurances (I; declined comment); Oversight Dems' Nov 18 letter on Epstein meetings / Maxwell transfer, due Dec 2; Nov 25 2026 (Wright-Patterson AFB): SAID Huang 'doesn't need a pardon at all' and that DOJ and national-security officials, including AG Blanche, told him Huang is 'under no investigation' (CBS/AP/NY Post)", "cluster": "gov", "clusterLabel": "Government / White House", "entityKind": "person"}, {"@id": "node/howard-lutnick", "@type": ["pm:Actor", "schema:Person"], "name": "Howard Lutnick", "description": "Commerce Secretary; ex-BGC/Cantor chief; BIS Entity List rule adding Megaspeed and six affiliates filed Nov 23 2026 4:15 pm (after months of intra-administration pressure, Bessent Nov 13; earlier: no Entity List additions in >1 year); Reuters (documents, Nov 20): asked Pure Lithium for a 51% US stake in July, refused (I); Commerce took a minority equity stake in I-Pulse with a $250M CHIPS award (Jun 25)", "cluster": "gov", "clusterLabel": "Government / White House", "entityKind": "person"}, {"@id": "node/scott-bessent", "@type": ["pm:Actor", "schema:Person"], "name": "Scott Bessent", "description": "Treasury Secretary; at the Trump-Putin bilateral in Shenzhen Nov 19 2026 (Kremlin); SAID Nov 13 four agencies favored listing Megaspeed; SAID Nov 15 Nvidia should hire an outside CEO; OFAC (Treasury) issued Lukoil GL 131L Nov 19; Nov 27: 'Have a wonderful winter' quote-post of Pezeshkian in an unheated office", "cluster": "gov", "clusterLabel": "Government / White House", "entityKind": "person"}, {"@id": "node/sergio-gor", "@type": ["pm:Actor", "schema:Person"], "name": "Sergio Gor", "description": "US Ambassador to India (still in post; Kolkata Oct 12 + Blackstone meet Oct 13)", "cluster": "gov", "clusterLabel": "Government / White House", "entityKind": "person"}, {"@id": "node/jay-clayton", "@type": ["pm:Actor", "schema:Person"], "name": "Jay Clayton", "description": "DNI (Jul 2026-) + WH AI/SI Force chair (Oct 2026) + acting National Cyber Director (Nov 23 2026, pending Davies's confirmation; WH official via CNBC/CyberScoop; Clayton on record: 'seamless transition'); SAID Nov 18 with Rubio the outages are 'not a cyberattack'; Trump SAID Nov 23 he consulted Clayton and Blanche before recommending Huang's return (NYT); CBS (Nov 25, anon.): deep dive on Alice Huang intel circulated to Trump; helped connect Nvidia board members to administration officials", "cluster": "gov", "clusterLabel": "Government / White House", "entityKind": "person"}, {"@id": "node/steve-witkoff", "@type": ["pm:Actor", "schema:Person"], "name": "Steve Witkoff", "description": "Special envoy (Mideast, Russia-Ukraine); met Putin in St Petersburg Oct 21 2026 (Hubbard freed); Nov 4 2026 90-min call with Zelenskyy + Kushner", "cluster": "gov", "clusterLabel": "Government / White House", "entityKind": "person"}, {"@id": "node/massad-boulos", "@type": ["pm:Actor", "schema:Person"], "name": "Massad Boulos", "description": "Sr adviser, Africa & Arab affairs", "cluster": "gov", "clusterLabel": "Government / White House", "entityKind": "person"}, {"@id": "node/charles-kushner", "@type": ["pm:Actor", "schema:Person"], "name": "Charles Kushner", "description": "US Ambassador to France & Monaco (still in post Oct 13 2026)", "cluster": "gov", "clusterLabel": "Government / White House", "entityKind": "person"}, {"@id": "node/kimberly-guilfoyle", "@type": ["pm:Actor", "schema:Person"], "name": "Kimberly Guilfoyle", "description": "Ex-US Ambassador to Greece (resigned Oct 13 2026 after WH ask)", "cluster": "gov", "clusterLabel": "Government / White House", "entityKind": "person"}, {"@id": "node/devin-nunes", "@type": ["pm:Actor", "schema:Person"], "name": "Devin Nunes", "description": "Chair, President's Intel Advisory Bd (since Feb 2025); left Trump Media Apr 21 2026 (salary continuation ended Sep 30 2026)", "cluster": "gov", "clusterLabel": "Government / White House", "entityKind": "person"}, {"@id": "node/michael-kratsios", "@type": ["pm:Actor", "schema:Person"], "name": "Michael Kratsios", "description": "OSTP Director", "cluster": "gov", "clusterLabel": "Government / White House", "entityKind": "person"}, {"@id": "node/ken-howery", "@type": ["pm:Actor", "schema:Person"], "name": "Ken Howery", "description": "US Ambassador to Denmark", "cluster": "gov", "clusterLabel": "Government / White House", "entityKind": "person"}, {"@id": "node/david-sacks", "@type": ["pm:Actor", "schema:Person"], "name": "David Sacks", "description": "PCAST co-chair (czar to Mar 2026)", "cluster": "gov", "clusterLabel": "Government / White House", "entityKind": "person"}, {"@id": "node/pete-hegseth", "@type": ["pm:Actor", "schema:Person"], "name": "Pete Hegseth", "description": "Secretary of War / Defense; signed a US-Venezuela military cooperation agreement with acting President Delcy Rodriguez in Caracas Nov 18 2026 (unannounced; Pentagon did not confirm, DW); fired Gen. Randy George Apr 2026; ex-aide LaNeve nominated Army chief Nov 17; his CIO Kirsten Davies named acting White House National Cyber Director Nov 19 2026 (acting role moved to DNI Clayton Nov 23; Davies to be nominated); SAID to Venezuelans Nov 19 'our war is over'", "cluster": "defense", "clusterLabel": "Defense & Intel", "entityKind": "person"}, {"@id": "node/stephen-feinberg", "@type": ["pm:Actor", "schema:Person"], "name": "Stephen Feinberg", "description": "Deputy SecDef (ex-Cerberus); brought ex-PE colleague Kollitides in as co-chief of staff (ProPublica)", "cluster": "defense", "clusterLabel": "Defense & Intel", "entityKind": "person"}, {"@id": "node/us-army", "@type": ["pm:Actor", "schema:GovernmentOrganization"], "name": "US Army", "description": "Army contracting", "cluster": "defense", "clusterLabel": "Defense & Intel", "entityKind": "government"}, {"@id": "node/us-space-force", "@type": ["pm:Actor", "schema:GovernmentOrganization"], "name": "US Space Force", "description": "Space Force contracting", "cluster": "defense", "clusterLabel": "Defense & Intel", "entityKind": "government"}, {"@id": "node/anduril", "@type": ["pm:Actor", "schema:Organization"], "name": "Anduril", "description": "Defense tech ($61B val., May 2026); CEO Schimpf $100K + COO Grimm $44.3K to Jeffries JFCs Apr/Aug 2026", "cluster": "defense", "clusterLabel": "Defense & Intel", "entityKind": "organization"}, {"@id": "node/palmer-luckey", "@type": ["pm:Actor", "schema:Person"], "name": "Palmer Luckey", "description": "Anduril founder; Meridian co-lead (Sep 2026)", "cluster": "defense", "clusterLabel": "Defense & Intel"