   "tieType": "sequence: OFAC sanctions delisting (2025-10-29) ... AAFS named lead pipeline developer",
   "category": "pardon/settlement",
   "kind": "register",
   "date": "2025-10-29 delisting ; by ~2026-04 lead-developer law",
