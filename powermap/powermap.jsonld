node/andreessen-horowitz", "@type": ["pm:Actor", "schema:Organization"], "name": "Andreessen Horowitz", "description": "VC firm (a16z)", "cluster": "thiel", "clusterLabel": "Thiel network (+ allied VC: a16z)", "entityKind": "organization"}, {"@id": "node/marc-andreessen-joe-lonsdale", "@type": ["pm:Actor", "pm:Group"], "name": "Marc Andreessen / Joe Lonsdale", "description": "VCs reported asked to aid DOGE", "cluster": "thiel", "clusterLabel": "Thiel network (+ allied VC: a16z)", "entityKind": "group"}, {"@id": "node/jim-o-neill", "@type": ["pm:Actor", "schema:Person"], "name": "Jim O'Neill", "description": "Ex-HHS Dep Sec (left Feb 2026)", "cluster": "thiel", "clusterLabel": "Thiel network (+ allied VC: a16z)", "entityKind": "person"}, {"@id": "node/sriram-krishnan", "@type": ["pm:Actor", "schema:Person"], "name": "Sriram Krishnan", "description": "Ex-WH AI adviser (left Jun 2026)", "cluster": "thiel", "clusterLabel": "Thiel network (+ allied VC: a16z)", "entityKind": "person"}, {"@id": "node/brian-quintenz", "@type": ["pm:Actor", "schema:Person"], "name": "Brian Quintenz", "description": "a16z crypto; CFTC nom. pulled 2025", "cluster": "thiel", "clusterLabel": "Thiel network (+ allied VC: a16z)", "entityKind": "person"}, {"@id": "node/elon-musk", "@type": ["pm:Actor", "schema:Person"], "name": "Elon Musk", "description": "SpaceX + Tesla CEO; biggest 2026 donor ($168M to Senate Leadership Fund, America PAC); SpaceX sells Anthropic up to $120.5B compute (S-1); Starshield cap lifted Oct 24 (Ukraine MoD); CBS (Nov 25, anon.): told Trump officials tech and business contacts were 'steadfastly behind' Huang", "cluster": "musk", "clusterLabel": "Musk network", "entityKind": "person"}, {"@id": "node/spacex", "@type": ["pm:Actor", "schema:Organization"], "name": "SpaceX", "description": "SpaceX (absorbed xAI Feb 2026); Anthropic compute buyer up to $120.5B to 2029 (Anthropic S-1, Oct 26 2026); $561M related-party gain on Boring stake (Q3 10-Q)", "cluster": "musk", "clusterL