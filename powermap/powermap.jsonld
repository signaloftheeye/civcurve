  {
   "@id": "tie/srpska-delisting-aafs-pipeline-sequence",
   "@type": "pm:Tie",
   "from": "node/republika-srpska-govt-dodik-snsd",
   "to": "node/aafs-infrastructure-energy-binnall-joseph-flynn",
