  {
   "@id": "tie/trump-john-g-trump-uncle-tesla-1943",
   "@type": "pm:Tie",
   "from": "node/donald-trump",
   "to": "node/john-g-trump-1907-1985",
   "name": "uncle; 1943 Tesla papers assessor",
   "tieType": "family (paternal uncle)",
   "category": "family",
   "kind": "register",
   "date": "1907-1985 ; Tesla papers report 1943-01-30",
   "grade": "V",
