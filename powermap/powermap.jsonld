abel": "Government / White House", "entityKind": "person"}, {"@id": "node/friedrich-merz-german-chancellor", "@type": ["pm:Actor", "schema:Person"], "name": "Friedrich Merz (German Chancellor)", "description": "German Chancellor; hosted the Coalition of the Willing summit in Berlin Nov 19 2026 with Macron and Burnham; SAID Europe will sit at new Ukraine talks, UAE a possible venue", "cluster": "gov", "clusterLabel": "Government / White House", "entityKind": "person"}, {"@id": "node/rob-bonta-california-ag", "@type": ["pm:Actor", "schema:Person"], "name": "Rob Bonta (California AG)", "description": "California Attorney General (D); served an investigative subpoena on Nvidia Nov 19 2026 over chips/confidential information to China and investor disclosure", "cluster": "gov", "clusterLabel": "Government / White House", "entityKind": "person"}, {"@id": "node/timothy-teter-nvidia-general-counsel", "@type": ["pm:Actor", "schema:Person"], "name": "Timothy Teter (Nvidia general counsel)", "description": "Nvidia EVP/general counsel; agreed to a Dec 2 2026 House transcribed interview; Form 144 Nov 19 2026 for a proposed sale of 30,000 shares (~$4.54M)", "cluster": "media", "clusterLabel": "Media owners & platforms", "entityKind": "person"}, {"@id": "node/sean-cairncross-outgoing-national-cyber-director", "@type": ["pm:Actor", "schema:Person"], "name": "Sean Cairncross (outgoing National Cyber Director)", "description": "White House National Cyber Director (Aug 2025 - Nov 2026); out Nov 19 2026 ('leaving' per WH official); Trump SAID Nov 20 he fired him because 'I didn't think that person was good enough'; ex-RNC COO (2016) and deputy COO (2024); ex-Millennium Challenge Corporation CEO", "cluster": "gov", "clusterLabel": "Government / White House", "entityKind": "person"}, {"@id": "node/michael-losapio-cisa-nominee", "@type": ["pm:Actor", "schema:Person"], "name": "Michael LoSapio (CISA nominee)", "description": "Palantir chief information security officer; Trump's nominee for 